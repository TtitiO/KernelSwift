#include "kernel_operator.h"

using namespace AscendC;

// 全向量化 Sinkhorn 融合算子（纯 AIV）。
// 核心思想：4x4 矩阵的行/列归约全部用 GatherMask 奇偶拆分 + Add/Max 两轮完成，
// 广播展开与批量转置用预计算偏移表 + Gather 完成，全程无标量 GetValue/SetValue。
//
// 数据布局：每核最多 32 个 4x4 矩阵，x[16m + 4r + c]（m: 矩阵, r: 行, c: 列）。
// 归约后的组结果布局：s[4m + r]（每行一个值）。

constexpr int32_t MAT_ELEMENTS = 16;
// 注意：工作区改为 256 floats（16 矩阵）时，AIV 子块对的 Gather 行为异常
// （核心 1 会读到核心 0 的 UB 数据，疑似双子块 UB 共享/寻址限制），保持 512。
constexpr int32_t MAX_MAT_PER_CORE = 32;
constexpr int32_t VEC_LEN = MAX_MAT_PER_CORE * MAT_ELEMENTS;  // 512，需为 128 的倍数（两轮 GatherMask）
constexpr int32_t HALF_LEN = VEC_LEN / 2;                     // 256
constexpr int32_t QRTR_LEN = VEC_LEN / 4;                     // 128

class SinkhornKernel {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR out, uint32_t total_matrices, uint32_t repeat, float eps) {
        this->repeat_ = repeat;
        this->eps_ = eps;

        // 该工具链下 kernel 以 MIX 方式启动（AIC+AIV 都会执行），
        // AIV 侧 GetBlockIdx() 为全局 AIV 下标（每 AI 核 2 个 AIV 子块）。
        // 这里仅让 AIV 工作，按 AIV 子块数做任务切分。
        uint32_t core_id = GetBlockIdx();
        uint32_t core_num = GetBlockNum() * GetSubBlockNum();

        uint32_t base_matrices = total_matrices / core_num;
        uint32_t tail_matrices = total_matrices % core_num;

        if (core_id < tail_matrices) {
            this->my_matrices_ = base_matrices + 1;
            this->my_offset_ = core_id * this->my_matrices_;
        } else {
            this->my_matrices_ = base_matrices;
            this->my_offset_ = core_id * base_matrices + tail_matrices;
        }

        this->my_elements_ = this->my_matrices_ * MAT_ELEMENTS;
        if (this->my_elements_ == 0) return;

        x_gm_.SetGlobalBuffer((__gm__ float*)x + this->my_offset_ * MAT_ELEMENTS, this->my_elements_);
        out_gm_.SetGlobalBuffer((__gm__ float*)out + this->my_offset_ * MAT_ELEMENTS, this->my_elements_);

        pipe_.InitBuffer(x_buf_, VEC_LEN * sizeof(float));
        pipe_.InitBuffer(t_buf_, VEC_LEN * sizeof(float));
        pipe_.InitBuffer(e_buf_, HALF_LEN * sizeof(float));
        pipe_.InitBuffer(o_buf_, HALF_LEN * sizeof(float));
        pipe_.InitBuffer(s_buf_, QRTR_LEN * sizeof(float));
        pipe_.InitBuffer(r_buf_, QRTR_LEN * sizeof(float));
        pipe_.InitBuffer(bc_buf_, VEC_LEN * sizeof(float));
        pipe_.InitBuffer(idx_exp_buf_, VEC_LEN * sizeof(uint32_t));
        pipe_.InitBuffer(idx_tr_buf_, VEC_LEN * sizeof(uint32_t));

        x_ = x_buf_.Get<float>();
        t_ = t_buf_.Get<float>();
        e_ = e_buf_.Get<float>();
        o_ = o_buf_.Get<float>();
        s_ = s_buf_.Get<float>();
        r_ = r_buf_.Get<float>();
        bc_ = bc_buf_.Get<float>();
        idx_exp_ = idx_exp_buf_.Get<uint32_t>();
        idx_tr_ = idx_tr_buf_.Get<uint32_t>();

        BuildOffsetTables();
    }

    __aicore__ inline void Process() {
        if (this->my_elements_ == 0) return;

        // 有效数据 416B 对齐（16 的倍数）满足 32B 对齐；尾部 padding 区为未初始化数据，
        // 但其计算结果只会留在 padding 组内（组边界按 4 元素对齐），不会污染有效区。
        DataCopy(x_, x_gm_, this->my_elements_);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);

        ComputeSinkhorn(x_);

        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopy(out_gm_, x_, this->my_elements_);
    }

private:
    // 偏移表只需构建一次：先标量写一个矩阵周期（16 项），再用 Adds 倍增扩展
    __aicore__ inline void BuildOffsetTables() {
        LocalTensor<int32_t> ie = idx_exp_buf_.Get<int32_t>();
        LocalTensor<int32_t> it = idx_tr_buf_.Get<int32_t>();
        // 广播展开表：exp[i] = src[i/4]，字节偏移 (i/4)*4
        for (int32_t i = 0; i < 16; ++i) {
            ie.SetValue(i, (i >> 2) * 4);
        }
        // 转置表：out[16m + 4c + r] = in[16m + 4r + c]，字节偏移 (4r + c)*4（矩阵 0）
        // 4x4 转置置换是对合（involution），同一张表可双向使用
        static const int32_t tr_base[16] = {0, 16, 32, 48, 4, 20, 36, 52, 8, 24, 40, 56, 12, 28, 44, 60};
        for (int32_t i = 0; i < 16; ++i) {
            it.SetValue(i, tr_base[i]);
        }
        // 倍增扩展：每周期 16 项。
        // idx_tr：每矩阵 16 个元素 -> 字节偏移 +64/矩阵，增量 = len*4 字节
        // idx_exp：16 个输出只消费 4 个源元素 -> 字节偏移 +16/周期，增量 = len 字节
        for (int32_t len = 16; len < VEC_LEN; len <<= 1) {
            Adds(ie[len], ie, len, len);
            Adds(it[len], it, len * 4, len);
        }
        PipeBarrier<PIPE_V>();
    }

    // s[i] = a[4i] + a[4i+1] + a[4i+2] + a[4i+3]，i < QRTR_LEN
    __aicore__ inline void GroupSum4(const LocalTensor<float>& a, const LocalTensor<float>& s) {
        uint64_t rsvd = 0;
        GatherMaskParams p1(1, VEC_LEN / 64, 8, 0);   // 每 repeat 读 256B(64 floats) -> 写 32 floats
        GatherMask(e_, a, (uint8_t)1, false, 0, p1, rsvd);  // 偶数元素
        GatherMask(o_, a, (uint8_t)2, false, 0, p1, rsvd);  // 奇数元素
        PipeBarrier<PIPE_V>();
        Add(e_, e_, o_, HALF_LEN);                          // e[j] = a[2j] + a[2j+1]
        GatherMaskParams p2(1, HALF_LEN / 64, 8, 0);
        GatherMask(s, e_, (uint8_t)1, false, 0, p2, rsvd);
        GatherMask(r_, e_, (uint8_t)2, false, 0, p2, rsvd);
        PipeBarrier<PIPE_V>();
        Add(s, s, r_, QRTR_LEN);
    }

    // s[i] = max(a[4i..4i+3])，i < QRTR_LEN
    __aicore__ inline void GroupMax4(const LocalTensor<float>& a, const LocalTensor<float>& s) {
        uint64_t rsvd = 0;
        GatherMaskParams p1(1, VEC_LEN / 64, 8, 0);
        GatherMask(e_, a, (uint8_t)1, false, 0, p1, rsvd);
        GatherMask(o_, a, (uint8_t)2, false, 0, p1, rsvd);
        PipeBarrier<PIPE_V>();
        Max(e_, e_, o_, HALF_LEN);
        GatherMaskParams p2(1, HALF_LEN / 64, 8, 0);
        GatherMask(s, e_, (uint8_t)1, false, 0, p2, rsvd);
        GatherMask(r_, e_, (uint8_t)2, false, 0, p2, rsvd);
        PipeBarrier<PIPE_V>();
        Max(s, s, r_, QRTR_LEN);
    }

    // r 精化：AIV 的 Reciprocal 只有 ~10 bit 精度，补一步 Newton 迭代 r = r*(2 - s*r)
    __aicore__ inline void RefineReciprocal(const LocalTensor<float>& s, const LocalTensor<float>& r) {
        Mul(e_, s, r, QRTR_LEN);            // e_ 此时空闲，作临时
        Muls(e_, e_, -1.0f, QRTR_LEN);
        Adds(e_, e_, 2.0f, QRTR_LEN);
        Mul(r, r, e_, QRTR_LEN);
    }

    // 行归一化：x[4i+k] /= (rowsum[i] + eps)
    __aicore__ inline void RowNormalize(LocalTensor<float>& a) {
        GroupSum4(a, s_);
        Adds(s_, s_, eps_, QRTR_LEN);
        Reciprocal(r_, s_, QRTR_LEN);
        RefineReciprocal(s_, r_);
        Gather(bc_, r_, idx_exp_, 0, VEC_LEN);   // bc_[i] = r_[i/4]
        Mul(a, a, bc_, VEC_LEN);
    }

    // 列归一化：转置 -> 行归一化 -> 转置回来
    __aicore__ inline void ColNormalize(LocalTensor<float>& a) {
        Gather(t_, a, idx_tr_, 0, VEC_LEN);
        RowNormalize(t_);
        Gather(a, t_, idx_tr_, 0, VEC_LEN);
    }

    __aicore__ inline void ComputeSinkhorn(LocalTensor<float>& x) {
        // 1. Softmax(dim=-1) + eps：x = exp(x - rowmax) / rowsum + eps
        GroupMax4(x, s_);
        Gather(bc_, s_, idx_exp_, 0, VEC_LEN);
        Sub(x, x, bc_, VEC_LEN);
        Exp(x, x, VEC_LEN);
        GroupSum4(x, s_);
        Reciprocal(r_, s_, QRTR_LEN);
        RefineReciprocal(s_, r_);
        Gather(bc_, r_, idx_exp_, 0, VEC_LEN);
        Mul(x, x, bc_, VEC_LEN);
        Adds(x, x, eps_, VEC_LEN);

        // 2. 首次列归一化
        ColNormalize(x);

        // 3. 剩余 repeat-1 次 行+列 归一化
        for (uint32_t i = 0; i < this->repeat_ - 1; ++i) {
            RowNormalize(x);
            ColNormalize(x);
        }
    }

    TPipe pipe_;
    TBuf<TPosition::VECCALC> x_buf_, t_buf_, e_buf_, o_buf_, s_buf_, r_buf_, bc_buf_;
    TBuf<TPosition::VECCALC> idx_exp_buf_, idx_tr_buf_;

    LocalTensor<float> x_, t_, e_, o_, s_, r_, bc_;
    LocalTensor<uint32_t> idx_exp_, idx_tr_;
    GlobalTensor<float> x_gm_, out_gm_;

    uint32_t repeat_;
    float eps_;
    uint32_t my_matrices_;
    uint32_t my_elements_;
    uint32_t my_offset_;
};

extern "C" __global__ __aicore__ void sinkhorn_kernel(GM_ADDR x, GM_ADDR out, uint32_t total_matrices, uint32_t repeat, float eps) {
    if ASCEND_IS_AIV {
        SinkhornKernel op;
        op.Init(x, out, total_matrices, repeat, eps);
        op.Process();
    }
}
