#include "kernel_operator.h"

using namespace AscendC;

constexpr int32_t MAT_ELEMENTS = 16;

class SinkhornKernel {
public:
    __aicore__ inline void Init(GM_ADDR x, uint32_t total_matrices, uint32_t repeat, float eps) {
        this->repeat_ = repeat;
        this->eps_ = eps;

        uint32_t core_id = GetBlockIdx();
        uint32_t core_num = GetBlockNum();
        
        uint32_t base_matrices = total_matrices / core_num;
        uint32_t tail_matrices = total_matrices % core_num;

        if (core_id < tail_matrices) {
            this->my_matrices_ = base_matrices + 1;
            this->my_offset_ = core_id * this->my_matrices_;
        } else {
            this->my_matrices_ = base_matrices;
            this->my_offset_ = core_id * base_matrices + tail_matrices;
        }

        this->my_elements_ = this->my_matrices_ * MAT_ELEMENTS;
        if (this->my_elements_ == 0) return;

        x_gm_.SetGlobalBuffer((__gm__ float*)x + this->my_offset_ * MAT_ELEMENTS, this->my_elements_);

        // 【对齐分配】: 为了防止后续 Exp 向量指令越界，分配的内存必须向上取整到 64 的倍数
        this->aligned_elements_ = (this->my_elements_ + 63) / 64 * 64;
        pipe_.InitBuffer(que_x_, 1, this->aligned_elements_ * sizeof(float));
    }

    __aicore__ inline void Process() {
        if (this->my_elements_ == 0) return;

        LocalTensor<float> local_x = que_x_.AllocTensor<float>();
        
        // DataCopy 支持非 64 倍数的 32 Byte 严格对齐搬运 (416 是 8 的倍数，绝对安全)
        DataCopy(local_x, x_gm_, this->my_elements_);

        ComputeSinkhorn(local_x);

        que_x_.EnQue(local_x);
        LocalTensor<float> out_x = que_x_.DeQue<float>();
        
        DataCopy(x_gm_, out_x, this->my_elements_);
        que_x_.FreeTensor(out_x);
    }

private:
    __aicore__ inline void ComputeSinkhorn(LocalTensor<float>& x) {
        ComputeSoftmax(x);
        ComputeColNormalize(x);
        for (uint32_t i = 0; i < this->repeat_ - 1; ++i) {
            ComputeRowNormalize(x);
            ComputeColNormalize(x);
        }
    }

    __aicore__ inline void ComputeSoftmax(LocalTensor<float>& x) {
        uint32_t rows = this->my_elements_ / 4;
        
        // 1. 每行减去最大值
        for (uint32_t i = 0; i < rows; ++i) {
            float v0 = x.GetValue(i * 4 + 0);
            float v1 = x.GetValue(i * 4 + 1);
            float v2 = x.GetValue(i * 4 + 2);
            float v3 = x.GetValue(i * 4 + 3);
            
            float m = v0;
            if (v1 > m) m = v1;
            if (v2 > m) m = v2;
            if (v3 > m) m = v3;
            
            x.SetValue(i * 4 + 0, v0 - m);
            x.SetValue(i * 4 + 1, v1 - m);
            x.SetValue(i * 4 + 2, v2 - m);
            x.SetValue(i * 4 + 3, v3 - m);
        }

        // 2. 求 Exp (按照对齐的长度执行，杜绝越界错误)
        Exp(x, x, this->aligned_elements_);

        // 3. 行归一化并加上 eps (原汁原味复现 PyTorch: x.softmax(-1) + eps)
        for (uint32_t i = 0; i < rows; ++i) {
            float v0 = x.GetValue(i * 4 + 0);
            float v1 = x.GetValue(i * 4 + 1);
            float v2 = x.GetValue(i * 4 + 2);
            float v3 = x.GetValue(i * 4 + 3);
            
            float s = v0 + v1 + v2 + v3;
            
            // 使用标准的标量除法，保证 100% FP32 IEEE 精度！
            x.SetValue(i * 4 + 0, v0 / s + this->eps_);
            x.SetValue(i * 4 + 1, v1 / s + this->eps_);
            x.SetValue(i * 4 + 2, v2 / s + this->eps_);
            x.SetValue(i * 4 + 3, v3 / s + this->eps_);
        }
    }

    __aicore__ inline void ComputeRowNormalize(LocalTensor<float>& x) {
        uint32_t rows = this->my_elements_ / 4;
        for (uint32_t i = 0; i < rows; ++i) {
            float v0 = x.GetValue(i * 4 + 0);
            float v1 = x.GetValue(i * 4 + 1);
            float v2 = x.GetValue(i * 4 + 2);
            float v3 = x.GetValue(i * 4 + 3);
            
            // 在寄存器内直接完成求和 + eps
            float s = v0 + v1 + v2 + v3 + this->eps_;
            
            // 精确除法写入
            x.SetValue(i * 4 + 0, v0 / s);
            x.SetValue(i * 4 + 1, v1 / s);
            x.SetValue(i * 4 + 2, v2 / s);
            x.SetValue(i * 4 + 3, v3 / s);
        }
    }

    __aicore__ inline void ComputeColNormalize(LocalTensor<float>& x) {
        for (uint32_t m = 0; m < this->my_matrices_; ++m) {
            uint32_t mat_offset = m * 16;
            for (uint32_t c = 0; c < 4; ++c) {
                float v0 = x.GetValue(mat_offset + c);
                float v1 = x.GetValue(mat_offset + c + 4);
                float v2 = x.GetValue(mat_offset + c + 8);
                float v3 = x.GetValue(mat_offset + c + 12);
                
                float s = v0 + v1 + v2 + v3 + this->eps_;
                
                x.SetValue(mat_offset + c, v0 / s);
                x.SetValue(mat_offset + c + 4, v1 / s);
                x.SetValue(mat_offset + c + 8, v2 / s);
                x.SetValue(mat_offset + c + 12, v3 / s);
            }
        }
    }

    TPipe pipe_;
    TQue<TPosition::VECOUT, 1> que_x_;
    GlobalTensor<float> x_gm_;

    uint32_t repeat_;
    float eps_;
    uint32_t my_matrices_;
    uint32_t my_elements_;
    uint32_t aligned_elements_;
    uint32_t my_offset_;
};

extern "C" __global__ __aicore__ __attribute__((core_type("AIV"))) void sinkhorn_kernel(GM_ADDR x, uint32_t total_matrices, uint32_t repeat, float eps) {
    SinkhornKernel op;
    op.Init(x, total_matrices, repeat, eps);
    op.Process();
}
