// ============================================================================
// Exact top-128 selector for the indexer score tensor, replacing the
// framework torch.topk + causal mask/where + offset stages.
//
//   in : scores bf16 [rows, N_PAD]  (rows = B*S, N_PAD = 672; when the fused
//        upstream kernel ran with causal=1 the padding cols >= actualT are
//        already -inf; for causal=0 we force cols >= actualT to -inf here)
//   out: int64 [rows, K] with the baseline postprocessing folded in:
//          causal rows: idx >= (s+1)/ratio  -> -1, else idx + offset
//          non-causal:  idx + offset
//
// Tie semantics: torch.topk on this NPU behaves exactly like a stable
// descending sort (ties keep ascending original index, verified empirically
// by probe_topk_ties.py).  The advanced AscendC::TopK (Sort32 + stable
// MrgSort tree) reproduces that order exactly (verified by probe_adv_topk.py
// on duplicate values and -inf blocks).
//
// The earlier attempt (audit 2026-08-23) failed with 507015 because the
// manual Sort32+MrgSort loop mishandled the vmrgsort4 exhausted-suspension
// semantics (a call stops when the first input list drains).  The advanced
// TopK implements the correct continuation internally, so this kernel is a
// thin batching wrapper around it: ROWS_PER_BATCH rows per call.
// ============================================================================

#include "kernel_operator.h"
#include "adv_api/kernel_tiling.h"

using namespace AscendC;

namespace {
constexpr int32_t TOPK_N = 672;          // padded score row length
constexpr int32_t TOPK_K = 128;          // fixed topk count
constexpr int32_t ROWS_PER_BATCH = 16;   // rows per TopK call
constexpr int32_t TMP_FLOATS = 3456;     // >= tiling.tmpLocalSize (3360)
}  // namespace

class IndexerTopkKernel {
public:
    // Three TopkTiling structs (inner = 224/448/672; 112 bytes = 28 int32
    // each) are passed as scalar kernel arguments: reading tiling from an
    // H2D-copied GM tensor proved context-dependent (megakernel read back
    // all-zeros in quiet process states; bare-loop 507035 is suspected to be
    // the same class of failure).  Tail batches with rem < ROWS_PER_BATCH
    // are padded to a full batch and their extra outputs are discarded.
    //
    // Valid-prefix pruning: for causal rows only the first limit=(s+1)/ratio
    // columns are non-(-inf); -inf entries sort last in stable order and
    // -inf ties keep ascending original index, so running TopK on any prefix
    // >= max(limit, TOPK_K) yields bit-identical results to the full 672.
    // Each batch picks the smallest group inner >= its max limit.
    __aicore__ inline void Init(GM_ADDR scores, GM_ADDR out, TPipe *pipe,
                                int32_t totalRows, int32_t rowsPerCore,
                                int32_t seqlen, int32_t causal, int32_t ratio,
                                int32_t actualT, int64_t offset,
                                const int32_t *ttArgs)
    {
        totalRows_ = totalRows;
        rowsPerCore_ = rowsPerCore;
        seqlen_ = seqlen;
        causal_ = causal != 0;
        ratio_ = ratio;
        actualT_ = actualT;
        offset_ = offset;

        constexpr uint32_t TT_INTS =
            sizeof(tiling::TopkTiling) / sizeof(int32_t);
        int32_t *di = reinterpret_cast<int32_t *>(&tt_);
        for (uint32_t i = 0; i < 2 * TT_INTS; ++i) {
            di[i] = ttArgs[i];
        }

        scoresGm_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(scores),
                                  (uint64_t)totalRows * TOPK_N);
        outGm_.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t *>(out),
                               (uint64_t)totalRows * TOPK_K);

        pipe->InitBuffer(inQ_, 2, ROWS_PER_BATCH * TOPK_N * sizeof(bfloat16_t));
        pipe->InitBuffer(outQ_, 1, ROWS_PER_BATCH * TOPK_K * sizeof(int64_t));
        pipe->InitBuffer(srcFBuf_, ROWS_PER_BATCH * TOPK_N * sizeof(float));
        pipe->InitBuffer(vBuf_, ROWS_PER_BATCH * TOPK_K * sizeof(float));
        pipe->InitBuffer(iBuf_, ROWS_PER_BATCH * TOPK_K * sizeof(int32_t));
        pipe->InitBuffer(aBuf_, ROWS_PER_BATCH * TOPK_K * sizeof(int32_t));
        pipe->InitBuffer(tBuf_, ROWS_PER_BATCH * TOPK_K * sizeof(int32_t));
        pipe->InitBuffer(tmpBuf_, TMP_FLOATS * sizeof(float));
        pipe->InitBuffer(dummyBuf_, 256);
    }

    __aicore__ inline void Process()
    {
        // Batches are strided across cores (batch bi -> core bi % 40) instead
        // of contiguous row ranges: with contiguous ranges most cores see
        // only high-limit rows and the kernel time is bounded by the slowest
        // core, defeating valid-prefix pruning.  Striding gives every core a
        // uniform mix of row limits.
        const int32_t core = GetBlockIdx();
        const int32_t nBatch =
            (int32_t)((totalRows_ + ROWS_PER_BATCH - 1) / ROWS_PER_BATCH);
        for (int32_t bi = core; bi < nBatch; bi += 40) {
            const int64_t r0 = (int64_t)bi * ROWS_PER_BATCH;
            int32_t rem = (int32_t)(totalRows_ - r0);
            if (rem > ROWS_PER_BATCH) {
                rem = ROWS_PER_BATCH;
            }
            ProcessBatch(r0, rem);
        }
    }

private:
    __aicore__ inline void ProcessBatch(int64_t r0, int32_t rem)
    {
        // Group inner for this batch: smallest of {224,448,672} covering the
        // largest valid limit among its rows (limits grow with s, so the max
        // is at one of the two ends).
        int32_t lim;
        if (causal_) {
            const int32_t s0 = (int32_t)(r0 % (int64_t)seqlen_);
            const int32_t s1 = (int32_t)((r0 + rem - 1) % (int64_t)seqlen_);
            const int32_t sMax = s0 > s1 ? s0 : s1;
            lim = (sMax + 1) / ratio_;
        } else {
            lim = actualT_;
        }
        // Dispatch to compile-time INNER specializations: the advanced TopK
        // is dramatically slower with a runtime inner (0.29 vs 0.64 ms).
        if (lim <= 224) {
            ProcessBatchWithInner<224>(r0, rem, tt_[0]);
        } else {
            ProcessBatchWithInner<TOPK_N>(r0, rem, tt_[1]);
        }
    }

    template <int32_t INNER>
    __aicore__ inline void ProcessBatchWithInner(
        int64_t r0, int32_t rem, const tiling::TopkTiling &tt)
    {
        constexpr int32_t inner = INNER;

        // CopyIn prefix columns (compact [rem, inner]) + cast to fp32.
        auto in = inQ_.AllocTensor<bfloat16_t>();
        AscendC::DataCopyExtParams cp{(uint16_t)rem,
                                      (uint32_t)(inner * sizeof(bfloat16_t)),
                                      (uint32_t)((TOPK_N - inner) *
                                                 sizeof(bfloat16_t)),
                                      0, 0};
        AscendC::DataCopyPadExtParams<bfloat16_t> pad{false, 0, 0, 0};
        AscendC::DataCopyPad(in, scoresGm_[r0 * TOPK_N], cp, pad);
        inQ_.EnQue(in);
        auto inLocal = inQ_.DeQue<bfloat16_t>();
        auto srcF = srcFBuf_.Get<float>();
        Cast(srcF, inLocal, RoundMode::CAST_NONE, rem * inner);
        inQ_.FreeTensor(inLocal);

        // causal=0: padding cols hold finite zero-scores, force them to -inf
        // (ragged scalar head + aligned Duplicate suffix per row; PIPE_ALL
        // barriers required around the scalar stores).
        if (!causal_ && actualT_ < inner) {
            const float negInf = -__builtin_huge_valf();
            const int32_t aAlign = (actualT_ + 7) & ~7;
            PipeBarrier<PIPE_ALL>();
            for (int32_t rr = 0; rr < rem; ++rr) {
                for (int32_t j = actualT_; j < aAlign && j < inner; ++j) {
                    srcF[rr * inner].SetValue(j, negInf);
                }
            }
            PipeBarrier<PIPE_ALL>();
            if (aAlign < inner) {
                for (int32_t rr = 0; rr < rem; ++rr) {
                    Duplicate<float>(srcF[rr * inner + aAlign], negInf,
                                     inner - aAlign);
                }
            }
            PipeBarrier<PIPE_V>();
        }

        auto v = vBuf_.Get<float>();
        auto iv = iBuf_.Get<int32_t>();
        auto tmp = tmpBuf_.Get<uint8_t>();
        auto dummy = dummyBuf_.Get<int32_t>();
        auto dummyB = dummyBuf_.Get<bool>();
        // Pad tail batches to a full ROWS_PER_BATCH batch with zero rows so a
        // single tiling struct covers every batch; padded outputs are
        // discarded (only rem rows are written out below).
        if (rem < ROWS_PER_BATCH) {
            PipeBarrier<PIPE_V>();
            Duplicate<float>(srcF[rem * inner], 0.0f,
                             (ROWS_PER_BATCH - rem) * inner);
        }
        TopKInfo info;
        info.outter = ROWS_PER_BATCH;
        info.inner = inner;
        info.n = inner;
        PipeBarrier<PIPE_V>();
        TopK<float, false, false, false, TopKMode::TOPK_NORMAL>(
            v, iv, srcF, dummy, dummyB, tmp, TOPK_K, tt, info, true);
        PipeBarrier<PIPE_V>();

        // Postprocess (int32 vector arithmetic, in place on iv):
        //   a  = idx + offset
        //   ge = clamp(idx - valid + 1, 0, 1)   (1 iff idx >= valid)
        //   out32 = a - (a + 1) * ge            (= -1 iff idx >= valid)
        auto a = aBuf_.Get<int32_t>();
        auto t = tBuf_.Get<int32_t>();
        const int32_t off32 = (int32_t)offset_;
        for (int32_t rr = 0; rr < rem; ++rr) {
            const int32_t s = (int32_t)((r0 + rr) % seqlen_);
            const int32_t valid = causal_ ? (s + 1) / ratio_ : 0x7fffffff;
            auto idxR = iv[rr * TOPK_K];
            auto aR = a[rr * TOPK_K];
            auto tR = t[rr * TOPK_K];
            Adds(aR, idxR, off32, TOPK_K);
            Adds(tR, idxR, 1 - valid, TOPK_K);
            Maxs(tR, tR, 0, TOPK_K);
            Mins(tR, tR, 1, TOPK_K);
            Adds(idxR, aR, 1, TOPK_K);
            Mul(idxR, idxR, tR, TOPK_K);
            Sub(idxR, aR, idxR, TOPK_K);
        }
        PipeBarrier<PIPE_V>();

        auto outLocal = outQ_.AllocTensor<int64_t>();
        Cast(outLocal, iv, RoundMode::CAST_NONE, rem * TOPK_K);
        outQ_.EnQue(outLocal);
        auto outReady = outQ_.DeQue<int64_t>();
        DataCopy(outGm_[r0 * TOPK_K], outReady, rem * TOPK_K);
        outQ_.FreeTensor(outReady);
    }

    int32_t totalRows_ = 0;
    int32_t rowsPerCore_ = 0;
    int32_t seqlen_ = 0;
    int32_t ratio_ = 1;
    int32_t actualT_ = 0;
    int64_t offset_ = 0;
    bool causal_ = false;
    tiling::TopkTiling tt_[2];

    GlobalTensor<bfloat16_t> scoresGm_;
    GlobalTensor<int64_t> outGm_;

    TQue<TPosition::VECIN, 2> inQ_;
    TQue<TPosition::VECOUT, 2> outQ_;
    TBuf<TPosition::VECCALC> srcFBuf_;
    TBuf<TPosition::VECCALC> vBuf_;
    TBuf<TPosition::VECCALC> iBuf_;
    TBuf<TPosition::VECCALC> aBuf_;
    TBuf<TPosition::VECCALC> tBuf_;
    TBuf<TPosition::VECCALC> tmpBuf_;
    TBuf<TPosition::VECCALC> dummyBuf_;
};

extern "C" __global__ __aicore__ void indexer_topk_kernel(
    GM_ADDR scores, GM_ADDR out, int32_t totalRows, int32_t rowsPerCore,
    int32_t seqlen, int32_t causal, int32_t ratio, int32_t actualT,
    int64_t offset, int32_t tt0, int32_t tt1, int32_t tt2, int32_t tt3, int32_t tt4, int32_t tt5, int32_t tt6, int32_t tt7, int32_t tt8, int32_t tt9, int32_t tt10, int32_t tt11, int32_t tt12, int32_t tt13, int32_t tt14, int32_t tt15, int32_t tt16, int32_t tt17, int32_t tt18, int32_t tt19, int32_t tt20, int32_t tt21, int32_t tt22, int32_t tt23, int32_t tt24, int32_t tt25, int32_t tt26, int32_t tt27, int32_t tt28, int32_t tt29, int32_t tt30, int32_t tt31, int32_t tt32, int32_t tt33, int32_t tt34, int32_t tt35, int32_t tt36, int32_t tt37, int32_t tt38, int32_t tt39, int32_t tt40, int32_t tt41, int32_t tt42, int32_t tt43, int32_t tt44, int32_t tt45, int32_t tt46, int32_t tt47, int32_t tt48, int32_t tt49, int32_t tt50, int32_t tt51, int32_t tt52, int32_t tt53, int32_t tt54, int32_t tt55)
{
    const int32_t ttRaw[56] = {tt0, tt1, tt2, tt3, tt4, tt5, tt6, tt7, tt8, tt9, tt10, tt11, tt12, tt13, tt14, tt15, tt16, tt17, tt18, tt19, tt20, tt21, tt22, tt23, tt24, tt25, tt26, tt27, tt28, tt29, tt30, tt31, tt32, tt33, tt34, tt35, tt36, tt37, tt38, tt39, tt40, tt41, tt42, tt43, tt44, tt45, tt46, tt47, tt48, tt49, tt50, tt51, tt52, tt53, tt54, tt55};
    TPipe pipe;
    IndexerTopkKernel op;
    op.Init(scores, out, &pipe, totalRows, rowsPerCore, seqlen, causal, ratio,
            actualT, offset, ttRaw);
    op.Process();
}
