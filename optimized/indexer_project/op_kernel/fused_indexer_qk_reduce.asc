// ============================================================================
// Fused indexer QK-reduce megakernel implemented with the basic Ascend C cube
// API (DataCopy/Nd2Nz + LoadData + Mmad + Fixpipe) instead of the high-level
// KFC Matmul objects (the KFC path deadlocked on CANN 8.5.2).
//
//   out[b, s, t] = sum_h relu(q[b,s,h,:] . kv[b,t,:]) * weights[b,s,h]
//   with the start_pos==0 causal mask (t >= (s+1)/ratio -> -inf) folded in.
//
//   __mix__(1,2): AIC runs the cube stages (CopyIn, SplitA/B, Mmad, Fixpipe)
//   per 4-token tile in 224-wide N chunks; AIV reduces each token's H=16 head
//   rows (ReLU -> per-row weight mul -> fp32 head sum -> bf16) and writes one
//   output row per token.  AIC and AIV synchronize with CrossCoreSetFlag /
//   CrossCoreWaitFlag (mode 2), batched every FLAG_BATCH=2 tiles.
//
// Score tiles flow through a per-core ring of NUM_SLOTS=2 batch slots in
// GM/L2 (bf16 [4*H, N] per tile — the fixpipe rounds fp32->bf16 with RNE,
// exactly the einsum-output rounding the baseline applies), so the 432MB
// intermediate never reaches HBM and slot traffic is halved vs fp32.
// AIC runs two batches ahead of the AIV reduce; before issuing batch
// b+2 into a slot it waits for the AIV's batch-b completion flag.
//
// Precision parity with the torch baseline: QK GEMM accumulates fp32 and
// rounds to bf16 via the fixpipe (einsum output), ReLU/weight-mul run in
// fp32, the head sum accumulates fp32 and the final row rounds to bf16.
// ============================================================================

#include "kernel_operator.h"
#include "indexer_tiling.h"

using namespace AscendC;

static constexpr int32_t TOKENS_PER_TILE = 8;
static constexpr int32_t HEADS = 16;                 // specialized H=16
static constexpr int32_t TILE_M = TOKENS_PER_TILE * HEADS;  // 64 rows
static constexpr int32_t N_CHUNK = 96;               // 16-aligned L0C chunk

static constexpr uint32_t CUBE_BLOCK = 16;
static constexpr uint32_t CUBE_BLOCK_SIZE = CUBE_BLOCK * CUBE_BLOCK;

static constexpr uint16_t FLAG_QK_READY = 1;
static constexpr uint16_t FLAG_AGG_READY = 2;
// Ring geometry is a runtime parameter (flagBatch tiles per flag, numSlots
// batch slots per core) so handshake configurations can be swept without
// rebuilding; defaults preserve the verified 2/2 protocol.

class FusedIndexerKernel {
public:
    // Tiling is passed as scalar kernel arguments: reading it from GM (copied
    // H2D once per process) proved context-dependent — in quiet process
    // states the kernel read back all-zeros and silently no-oped.
    __aicore__ inline void Init(GM_ADDR q, GM_ADDR kvT, GM_ADDR weights,
                                GM_ADDR out, GM_ADDR scores,
                                int32_t totalTiles, int32_t tilesPerCore,
                                int32_t mPerBatch, int32_t h, int32_t n,
                                int32_t d, int32_t causal, int32_t ratio,
                                int32_t blockNum, int32_t nChunks,
                                int32_t flagBatch, int32_t numSlots,
                                TPipe *pipe)
    {
        pipe_ = pipe;
        tiling_.totalTiles = totalTiles;
        tiling_.tilesPerCore = tilesPerCore;
        tiling_.mPerBatch = mPerBatch;
        tiling_.h = h;
        tiling_.n = n;
        tiling_.d = d;
        tiling_.causal = causal;
        tiling_.ratio = ratio;
        tiling_.blockNum = blockNum;
        tiling_.nChunks = nChunks;
        fb_ = flagBatch;
        ns_ = numSlots;
        n_ = tiling_.n;
        d_ = tiling_.d;
        mPerBatch_ = tiling_.mPerBatch;
        causal_ = tiling_.causal != 0;
        ratio_ = tiling_.ratio;
        nChunks_ = tiling_.nChunks;

        qGm_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(q),
                             (uint64_t)tiling_.totalTiles * TILE_M * d_);
        kvTGm_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(kvT),
                               (uint64_t)(tiling_.totalTiles * TOKENS_PER_TILE /
                                          mPerBatch_) * d_ * n_);
        weightsGm_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(weights),
                                   (uint64_t)tiling_.totalTiles * TILE_M);
        outGm_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(out),
                               (uint64_t)tiling_.totalTiles * TOKENS_PER_TILE * n_);
        scoresGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ bfloat16_t *>(scores),
            (uint64_t)tiling_.blockNum * ns_ * fb_ * TILE_M * n_);

        if ASCEND_IS_AIC {
            // A/B queues are double-buffered so the MTE can prefetch while the
            // cube computes.
            pipe_->InitBuffer(inQueueA1_, 2, TILE_M * d_ * sizeof(bfloat16_t));
            pipe_->InitBuffer(inQueueA2_, 1, TILE_M * d_ * sizeof(bfloat16_t));
            pipe_->InitBuffer(inQueueB1_, 2, d_ * n_ * sizeof(bfloat16_t));
            pipe_->InitBuffer(inQueueB2_, 2, d_ * N_CHUNK * sizeof(bfloat16_t));
            pipe_->InitBuffer(outQueueCO1_, 2, TILE_M * N_CHUNK * sizeof(float));
        }

        if ASCEND_IS_AIV {
            // Per tile each AIV sub-block handles 4 tokens; the pipeline unit
            // is one token = H score rows.
            pipe_->InitBuffer(scoresQ_, 2, HEADS * n_ * sizeof(bfloat16_t));
            pipe_->InitBuffer(outQ_, 2, 4 * n_ * sizeof(bfloat16_t));
            pipe_->InitBuffer(workBuf_, HEADS * n_ * sizeof(float));
            // Baseline rounds every relu*weight product to bf16 before the
            // fp32 head sum; this scratch holds the rounded products.
            pipe_->InitBuffer(workBBuf_, HEADS * n_ * sizeof(bfloat16_t));
            pipe_->InitBuffer(outF32Buf_, 4 * n_ * sizeof(float));
            pipe_->InitBuffer(wBuf_, HEADS * sizeof(bfloat16_t));
            pipe_->InitBuffer(wF32Buf_, HEADS * sizeof(float));
        }
    }

    __aicore__ inline void Process()
    {
        if ASCEND_IS_AIC {
            ProcessAic();
        } else {
            ProcessAiv();
        }
    }

private:
    // ------------------------------------------------------------------
    // Shared helpers
    // ------------------------------------------------------------------
    __aicore__ inline uint32_t CeilCubeBlock(uint32_t len)
    {
        return (len + CUBE_BLOCK - 1U) / CUBE_BLOCK;
    }

    __aicore__ inline int32_t ChunkN(int32_t c) const
    {
        const int32_t rem = n_ - c * N_CHUNK;
        return rem < N_CHUNK ? rem : N_CHUNK;
    }

    // GM offset (elements) of tile-local index tl's score slot for a core.
    __aicore__ inline int64_t SlotOff(int32_t core, int64_t tl) const
    {
        const int64_t slot = (tl / fb_) % ns_;
        const int64_t pos = tl % fb_;
        return ((int64_t)core * (ns_ * fb_) + slot * fb_ + pos) * TILE_M * n_;
    }

    // ------------------------------------------------------------------
    // AIC: basic cube pipeline (mirrors the proven sparse-attention flow)
    // ------------------------------------------------------------------
    __aicore__ inline void CopyInA(int64_t t)
    {
        auto a1 = inQueueA1_.AllocTensor<bfloat16_t>();
        AscendC::Nd2NzParams p;
        p.ndNum = 1;
        p.nValue = TILE_M;
        p.dValue = d_;
        p.srcNdMatrixStride = 0;
        p.srcDValue = d_;
        p.dstNzC0Stride = CeilCubeBlock(TILE_M) * CUBE_BLOCK;
        p.dstNzNStride = 1;
        p.dstNzMatrixStride = 0;
        AscendC::DataCopy(a1, qGm_[t * TILE_M * d_], p);
        inQueueA1_.EnQue(a1);
    }

    // Preload one batch's kvT operand [d_, n_] into L1 in NZ layout, once per
    // core instead of per tile: every tile of the same batch previously
    // re-read the full 86 KB operand from GM (~447 MB strided traffic).
    __aicore__ inline void PreloadB(int32_t b)
    {
        auto b1 = inQueueB1_.AllocTensor<bfloat16_t>();
        AscendC::Nd2NzParams p;
        p.ndNum = 1;
        p.nValue = d_;
        p.dValue = n_;
        p.srcNdMatrixStride = 0;
        p.srcDValue = n_;
        p.dstNzC0Stride = CeilCubeBlock(d_) * CUBE_BLOCK;
        p.dstNzNStride = 1;
        p.dstNzMatrixStride = 0;
        AscendC::DataCopy(b1, kvTGm_[(int64_t)b * d_ * n_], p);
        inQueueB1_.EnQue(b1);
    }

    __aicore__ inline void SplitA()
    {
        auto a1 = inQueueA1_.DeQue<bfloat16_t>();
        auto a2 = inQueueA2_.AllocTensor<bfloat16_t>();

        uint32_t dstOffset = CeilCubeBlock(d_) * CUBE_BLOCK_SIZE;
        uint32_t srcOffset = CUBE_BLOCK_SIZE;
        AscendC::LoadData2DParams p;
        p.repeatTimes = CeilCubeBlock(d_);
        p.srcStride = CeilCubeBlock(TILE_M);
        p.dstGap = 0;
        p.ifTranspose = false;
        for (uint32_t i = 0; i < CeilCubeBlock(TILE_M); ++i) {
            AscendC::LoadData(a2[i * dstOffset], a1[i * srcOffset], p);
        }

        inQueueA2_.EnQue<bfloat16_t>(a2);
        inQueueA1_.FreeTensor(a1);
    }

    // Slice chunk c of the preloaded full-width NZ operand.  Each 16-column
    // panel occupies d_*16 elements, so chunk c starts at c*N_CHUNK*d_ —
    // bit-identical layout to the old per-chunk Nd2Nz copy.
    __aicore__ inline void SplitB(const LocalTensor<bfloat16_t> &b1, int32_t c,
                                  int32_t cn)
    {
        auto b2 = inQueueB2_.AllocTensor<bfloat16_t>();

        uint32_t dstOffset = CeilCubeBlock(cn) * CUBE_BLOCK_SIZE;
        uint32_t srcOffset = CUBE_BLOCK_SIZE;
        AscendC::LoadData2DParams p;
        p.repeatTimes = CeilCubeBlock(cn);
        p.srcStride = CeilCubeBlock(d_);
        p.dstGap = 0;
        p.ifTranspose = true;
        const auto src = b1[(int64_t)c * N_CHUNK * d_];
        for (uint32_t i = 0; i < CeilCubeBlock(d_); ++i) {
            AscendC::LoadData(b2[i * dstOffset], src[i * srcOffset], p);
        }

        inQueueB2_.EnQue<bfloat16_t>(b2);
    }

    __aicore__ inline void QkTile(int64_t t, int64_t wsOff,
                                  const LocalTensor<bfloat16_t> &b1)
    {
#ifndef PROF_SKIP_A
        CopyInA(t);
        SplitA();
#else
        {   // keep queue discipline with a garbage tensor (timing only)
            auto a2e = inQueueA2_.AllocTensor<bfloat16_t>();
            inQueueA2_.EnQue(a2e);
        }
#endif
        auto a2 = inQueueA2_.DeQue<bfloat16_t>();
        for (int32_t c = 0; c < nChunks_; ++c) {
            const int32_t cn = ChunkN(c);
#ifndef PROF_SKIP_B
            SplitB(b1, c, cn);
#else
            {
                auto b2e = inQueueB2_.AllocTensor<bfloat16_t>();
                inQueueB2_.EnQue(b2e);
            }
#endif
            auto b2 = inQueueB2_.DeQue<bfloat16_t>();
            auto c1 = outQueueCO1_.AllocTensor<float>();
            AscendC::MmadParams mp;
            mp.m = TILE_M;
            mp.n = cn;
            mp.k = d_;
            mp.cmatrixInitVal = true;
#ifndef PROF_SKIP_MMAD
            AscendC::Mmad(c1, a2, b2, mp);
#endif
            outQueueCO1_.EnQue<float>(c1);
            inQueueB2_.FreeTensor(b2);

            auto c1r = outQueueCO1_.DeQue<float>();
            AscendC::FixpipeParamsV220 fp;
            fp.nSize = cn;
            fp.mSize = TILE_M;
            fp.srcStride = TILE_M;
            fp.dstStride = n_;
            fp.quantPre = QuantMode_t::F322BF16;
            fp.reluEn = false;
            fp.ndNum = 1;
            fp.srcNdStride = 0;
            fp.dstNdStride = 0;
#ifndef PROF_SKIP_FIX
            AscendC::Fixpipe<bfloat16_t, float, AscendC::CFG_ROW_MAJOR>(
                scoresGm_[wsOff + c * N_CHUNK], c1r, fp);
#endif
            outQueueCO1_.FreeTensor(c1r);
        }
        inQueueA2_.FreeTensor(a2);
    }

    __aicore__ inline void RunQkBatch(int32_t core, int64_t tStart, int64_t tEnd,
                                      int64_t b,
                                      const LocalTensor<bfloat16_t> &b1Lo,
                                      const LocalTensor<bfloat16_t> &b1Hi,
                                      int32_t bLo)
    {
        const int64_t bs = tStart + b * fb_;
        int64_t be = bs + fb_;
        if (be > tEnd) {
            be = tEnd;
        }
        for (int64_t t = bs; t < be; ++t) {
            const int32_t tb = (int32_t)((t * TOKENS_PER_TILE) / mPerBatch_);
            QkTile(t, SlotOff(core, t - tStart), tb == bLo ? b1Lo : b1Hi);
        }
        // The flag is set on the FIX pipe so all score-slot writes are
        // visible to the AIV before it is released.
        AscendC::CrossCoreSetFlag<2, PIPE_FIX>(FLAG_QK_READY);
    }

    __aicore__ inline void ProcessAic()
    {
        const int32_t core = GetBlockIdx();
        const int64_t tStart = (int64_t)core * tiling_.tilesPerCore;
        int64_t tEnd = tStart + tiling_.tilesPerCore;
        if (tEnd > tiling_.totalTiles) {
            tEnd = tiling_.totalTiles;
        }
        if (tStart >= tEnd) {
            return;
        }
        const int64_t nTile = tEnd - tStart;
        const int64_t nBatch = (nTile + fb_ - 1) / fb_;

        // Contiguous tiles per core span at most two batches; preload both
        // kvT operands into L1 once (held for the whole kernel).
        const int32_t bLo = (int32_t)((tStart * TOKENS_PER_TILE) / mPerBatch_);
        const int32_t bHi =
            (int32_t)(((tEnd - 1) * TOKENS_PER_TILE) / mPerBatch_);
        PreloadB(bLo);
        auto b1Lo = inQueueB1_.DeQue<bfloat16_t>();
        LocalTensor<bfloat16_t> b1Hi = b1Lo;
        if (bHi != bLo) {
            PreloadB(bHi);
            b1Hi = inQueueB1_.DeQue<bfloat16_t>();
        }

        // Up to numSlots batches in flight before the first AIV handshake:
        // QK(b+numSlots) reuses batch b's slot and waits for its AGG flag.
        const int64_t pro = nBatch < ns_ ? nBatch : ns_;
        for (int64_t b = 0; b < pro; ++b) {
            RunQkBatch(core, tStart, tEnd, b, b1Lo, b1Hi, bLo);
        }
        for (int64_t b = 0; b + ns_ < nBatch; ++b) {
            AscendC::CrossCoreWaitFlag(FLAG_AGG_READY);
            RunQkBatch(core, tStart, tEnd, b + ns_, b1Lo, b1Hi, bLo);
        }

        inQueueB1_.FreeTensor(b1Lo);
        if (bHi != bLo) {
            inQueueB1_.FreeTensor(b1Hi);
        }
    }

    // ------------------------------------------------------------------
    // AIV: ReLU + weighted head reduce + causal mask
    // ------------------------------------------------------------------
    __aicore__ inline void PrefetchScores(int32_t core, int64_t tl, int32_t tok)
    {
        const int32_t sub = AscendC::GetSubBlockIdx();
        auto scores = scoresQ_.AllocTensor<bfloat16_t>();
        AscendC::DataCopy(scores,
                          scoresGm_[SlotOff(core, tl) +
                                    (int64_t)(sub * 4 + tok) * HEADS * n_],
                          HEADS * n_);
        scoresQ_.EnQue(scores);
    }

    // Reduce one token's H score rows; the reduced row lands in
    // outF32Buf_[tok * n_].  Returns nothing; the tile output is written by
    // WriteTileOut once both tokens are done.
    __aicore__ inline void ConsumeToken(int64_t t, int32_t tok)
    {
        const int32_t sub = AscendC::GetSubBlockIdx();
        const int32_t b = (int32_t)((t * TOKENS_PER_TILE) / mPerBatch_);
        const int32_t s =
            (int32_t)((t * TOKENS_PER_TILE) % mPerBatch_) + sub * 4 + tok;
        const int32_t tileLen = HEADS * n_;

        auto scores = scoresQ_.DeQue<bfloat16_t>();
        auto work = workBuf_.Get<float>();
        // The fixpipe already rounded the fp32 GEMM output to bf16 (RNE),
        // exactly like the baseline einsum output; widen back to fp32.
        AscendC::Cast(work, scores, AscendC::RoundMode::CAST_NONE, tileLen);
        scoresQ_.FreeTensor(scores);
        AscendC::Maxs(work, work, 0.0f, tileLen);

        auto outF = outF32Buf_.Get<float>();
        auto rowF = outF[(int64_t)tok * n_];
        // Per-head weights for this token row.
        auto w = wBuf_.Get<bfloat16_t>();
        auto wF = wF32Buf_.Get<float>();
        AscendC::DataCopy(w, weightsGm_[((int64_t)b * mPerBatch_ + s) * HEADS],
                          HEADS);
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::Cast(wF, w, AscendC::RoundMode::CAST_NONE, HEADS);
        AscendC::PipeBarrier<PIPE_ALL>();
        for (int32_t r = 0; r < HEADS; ++r) {
            AscendC::Muls(work[(int64_t)r * n_], work[(int64_t)r * n_],
                          wF.GetValue(r), n_);
        }
        // Match the baseline's bf16 product rounding (bf16 mul output) before
        // the fp32 head sum.
        auto rounded = workBBuf_.Get<bfloat16_t>();
        AscendC::Cast(rounded, work, AscendC::RoundMode::CAST_RINT, tileLen);
        AscendC::Cast(work, rounded, AscendC::RoundMode::CAST_NONE, tileLen);

        // Head sum: outF[tok] = sum_h work[h], fp32 accumulate.
        AscendC::Adds(rowF, work, 0.0f, n_);
        for (int32_t r = 1; r < HEADS; ++r) {
            AscendC::Add(rowF, rowF, work[(int64_t)r * n_], n_);
        }

        // Causal mask: cols >= (s+1)/ratio become -inf.  Ragged head with
        // scalar stores, then an aligned Duplicate for the suffix.
        if (causal_) {
            const int32_t limit = (s + 1) / ratio_;
            if (limit < n_) {
                const float negInf = -__builtin_huge_valf();
                const int32_t limAlign = (limit + 7) & ~7;
                AscendC::PipeBarrier<PIPE_ALL>();
                for (int32_t j = limit; j < limAlign && j < n_; ++j) {
                    rowF.SetValue(j, negInf);
                }
                AscendC::PipeBarrier<PIPE_ALL>();
                if (limAlign < n_) {
                    AscendC::Duplicate<float>(rowF[limAlign], negInf,
                                              n_ - limAlign);
                }
            }
        }
    }

    __aicore__ inline void WriteTileOut(int64_t t)
    {
        const int32_t sub = AscendC::GetSubBlockIdx();
        const int32_t b = (int32_t)((t * TOKENS_PER_TILE) / mPerBatch_);
        const int32_t s0 =
            (int32_t)((t * TOKENS_PER_TILE) % mPerBatch_) + sub * 4;

        auto outF = outF32Buf_.Get<float>();
        auto out = outQ_.AllocTensor<bfloat16_t>();
        AscendC::Cast(out, outF, AscendC::RoundMode::CAST_RINT, 4 * n_);
        outQ_.EnQue(out);
        auto outReady = outQ_.DeQue<bfloat16_t>();
        AscendC::DataCopy(outGm_[((int64_t)b * mPerBatch_ + s0) * n_], outReady,
                          4 * n_);
        outQ_.FreeTensor(outReady);
    }

    __aicore__ inline void ProcessAiv()
    {
        // Each AI core has two AIV sub-blocks; both consume the AIC flag and
        // both signal AGG.  AIV0 reduces tokens 0-3 of every tile, AIV1 4-7.
        const int32_t core = GetBlockIdx() / AscendC::GetSubBlockNum();
        const int64_t tStart = (int64_t)core * tiling_.tilesPerCore;
        int64_t tEnd = tStart + tiling_.tilesPerCore;
        if (tEnd > tiling_.totalTiles) {
            tEnd = tiling_.totalTiles;
        }
        if (tStart >= tEnd) {
            return;
        }
        const int64_t nTile = tEnd - tStart;
        const int64_t nBatch = (nTile + fb_ - 1) / fb_;

        for (int64_t b = 0; b < nBatch; ++b) {
            AscendC::CrossCoreWaitFlag(FLAG_QK_READY);

            const int64_t bs = tStart + b * fb_;
            int64_t be = bs + fb_;
            if (be > tEnd) {
                be = tEnd;
            }
            const int32_t units = (int32_t)(be - bs) * 4;  // 4 tokens per tile

            // Ping-pong prefetch: load token unit u+1 while computing u.
            PrefetchScores(core, bs - tStart, 0);
            for (int32_t u = 0; u < units; ++u) {
                const int64_t t = bs + u / 4;
                const int32_t tok = u & 3;
                if (u + 1 < units) {
                    PrefetchScores(core, t + ((tok + 1) >> 2) - tStart,
                                   (tok + 1) & 3);
                }
                ConsumeToken(t, tok);
                if (tok == 3) {
                    WriteTileOut(t);
                }
            }

            // The slot reads (MTE2) and output writes (MTE3) must all be done
            // before the AIC may refill this slot.
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::CrossCoreSetFlag<2, PIPE_MTE3>(FLAG_AGG_READY);
        }
    }

    TPipe *pipe_ = nullptr;
    IndexerTiling tiling_;
    int32_t n_ = 0, d_ = 0, mPerBatch_ = 0, ratio_ = 0, nChunks_ = 0;
    int32_t fb_ = 2, ns_ = 2;
    bool causal_ = false;

    GlobalTensor<bfloat16_t> qGm_;
    GlobalTensor<bfloat16_t> kvTGm_;
    GlobalTensor<bfloat16_t> weightsGm_;
    GlobalTensor<bfloat16_t> outGm_;
    GlobalTensor<bfloat16_t> scoresGm_;

    // AIC L1/L0 queues
    TQue<TPosition::A1, 2> inQueueA1_;
    TQue<TPosition::A2, 1> inQueueA2_;
    TQue<TPosition::B1, 2> inQueueB1_;
    TQue<TPosition::B2, 1> inQueueB2_;
    TQue<TPosition::CO1, 1> outQueueCO1_;

    // AIV UB queues
    TQue<TPosition::VECIN, 2> scoresQ_;  // bf16 score rows
    TQue<TPosition::VECOUT, 2> outQ_;
    TBuf<TPosition::VECCALC> workBuf_;
    TBuf<TPosition::VECCALC> workBBuf_;
    TBuf<TPosition::VECCALC> outF32Buf_;
    TBuf<TPosition::VECCALC> wBuf_;
    TBuf<TPosition::VECCALC> wF32Buf_;
};

extern "C" __global__ __mix__(1, 2) void fused_indexer_qk_reduce(
    GM_ADDR q, GM_ADDR kvT, GM_ADDR weights, GM_ADDR out, GM_ADDR scores,
    int32_t totalTiles, int32_t tilesPerCore, int32_t mPerBatch, int32_t h,
    int32_t n, int32_t d, int32_t causal, int32_t ratio, int32_t blockNum,
    int32_t nChunks, int32_t flagBatch, int32_t numSlots)
{
    TPipe pipe;
    FusedIndexerKernel op;
    op.Init(q, kvT, weights, out, scores, totalTiles, tilesPerCore, mPerBatch,
            h, n, d, causal, ratio, blockNum, nChunks, flagBatch, numSlots,
            &pipe);
    op.Process();
}

// ============================================================================
// In-place RoPE on the trailing rope segment of q [B, S, H, D] (bf16).
// Pairs (2j, 2j+1) rotate by freqs[s, j] = (cos, sin), computed in fp32 and
// rounded back to bf16 with RNE (CAST_RINT) to match the torch baseline
// bit-for-bit:
//   out[2j]   = x[2j] * cos[j] - x[2j+1] * sin[j]
//   out[2j+1] = x[2j] * sin[j] + x[2j+1] * cos[j]
// Implemented as out = x * cs + swap(x) * sn with cs/sn broadcast per s.
// One unit = one (b, s): H head rows x 2*pairs columns, strided within D.
// ============================================================================
class IndexerRopeKernel {
public:
    static constexpr int32_t ROPE_BLOCKS = 40;

    __aicore__ inline void Init(GM_ADDR q, GM_ADDR freqs, int32_t b, int32_t s,
                                int32_t h, int32_t d, int32_t pairs,
                                TPipe *pipe)
    {
        b_ = b;
        s_ = s;
        h_ = h;
        d_ = d;
        pairs_ = pairs;
        seg_ = 2 * pairs;  // rope segment length (elements per head row)
        cnt_ = h * seg_;   // elements per (b, s) unit

        qGm_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(q),
                             (uint64_t)b * s * h * d);
        freqsGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(freqs),
                                 (uint64_t)s * seg_);

        pipe->InitBuffer(inQ_, 2, cnt_ * sizeof(bfloat16_t));
        pipe->InitBuffer(outQ_, 2, cnt_ * sizeof(bfloat16_t));
        pipe->InitBuffer(xFBuf_, cnt_ * sizeof(float));
        pipe->InitBuffer(swapBuf_, cnt_ * sizeof(float));
        pipe->InitBuffer(csBBuf_, cnt_ * sizeof(float));
        pipe->InitBuffer(snBBuf_, cnt_ * sizeof(float));
        pipe->InitBuffer(freqBuf_, seg_ * sizeof(float));
        pipe->InitBuffer(csBuf_, seg_ * sizeof(float));
        pipe->InitBuffer(snBuf_, seg_ * sizeof(float));
        pipe->InitBuffer(swapTabBuf_, cnt_ * sizeof(int32_t));
        pipe->InitBuffer(csTabBuf_, seg_ * sizeof(int32_t));
        pipe->InitBuffer(snTabBuf_, seg_ * sizeof(int32_t));
        pipe->InitBuffer(signBuf_, seg_ * sizeof(float));
        pipe->InitBuffer(bcastTmpBuf_, 4096 * sizeof(uint8_t));
    }

    __aicore__ inline void Prepare()
    {
        auto swapTab = swapTabBuf_.Get<int32_t>();
        auto csTab = csTabBuf_.Get<int32_t>();
        auto snTab = snTabBuf_.Get<int32_t>();
        auto sign = signBuf_.Get<float>();
        for (int32_t i = 0; i < cnt_; ++i) {
            swapTab.SetValue(i, (i ^ 1) * (int32_t)sizeof(float));
        }
        for (int32_t i = 0; i < seg_; ++i) {
            csTab.SetValue(i, (i / 2) * 2 * (int32_t)sizeof(float));
            snTab.SetValue(i, (i / 2) * 2 * (int32_t)sizeof(float) +
                                  (int32_t)sizeof(float));
            sign.SetValue(i, (i & 1) ? 1.0f : -1.0f);
        }
        AscendC::PipeBarrier<PIPE_ALL>();
    }

    // Build the per-s cs/sn broadcast tiles [h_, seg_].
    __aicore__ inline void BuildCsSn(int32_t sv)
    {
        auto freq = freqBuf_.Get<float>();
        AscendC::DataCopy(freq, freqsGm_[(int64_t)sv * seg_], seg_);
        AscendC::PipeBarrier<PIPE_ALL>();

        auto cs = csBuf_.Get<float>();
        auto sn = snBuf_.Get<float>();
        auto csTab = csTabBuf_.Get<int32_t>();
        auto snTab = snTabBuf_.Get<int32_t>();
        auto sign = signBuf_.Get<float>();
        AscendC::Gather(cs, freq, csTab.ReinterpretCast<uint32_t>(), 0, seg_);
        AscendC::Gather(sn, freq, snTab.ReinterpretCast<uint32_t>(), 0, seg_);
        AscendC::Mul(sn, sn, sign, seg_);

        auto csB = csBBuf_.Get<float>();
        auto snB = snBBuf_.Get<float>();
        auto bcastTmp = bcastTmpBuf_.Get<uint8_t>();
        const uint32_t dstShape[2] = {(uint32_t)h_, (uint32_t)seg_};
        const uint32_t srcShape[2] = {1, (uint32_t)seg_};
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::Broadcast<float, 2, 0>(csB, cs, dstShape, srcShape, bcastTmp);
        AscendC::Broadcast<float, 2, 0>(snB, sn, dstShape, srcShape, bcastTmp);
    }

    __aicore__ inline void ProcessUnit(int32_t bv, int32_t sv)
    {
        const int64_t base = ((int64_t)bv * s_ + sv) * h_ * d_ + (d_ - seg_);

        auto in = inQ_.AllocTensor<bfloat16_t>();
        AscendC::DataCopyExtParams inParams{(uint16_t)h_,
                                            (uint32_t)(seg_ * sizeof(bfloat16_t)),
                                            (uint32_t)((d_ - seg_) *
                                                       sizeof(bfloat16_t)),
                                            0, 0};
        AscendC::DataCopyPadExtParams<bfloat16_t> pad{false, 0, 0, 0};
        AscendC::DataCopyPad(in, qGm_[base], inParams, pad);
        inQ_.EnQue(in);

        auto x = inQ_.DeQue<bfloat16_t>();
        auto xF = xFBuf_.Get<float>();
        AscendC::Cast(xF, x, AscendC::RoundMode::CAST_NONE, cnt_);
        inQ_.FreeTensor(x);

        auto swap = swapBuf_.Get<float>();
        auto swapTab = swapTabBuf_.Get<int32_t>();
        AscendC::Gather(swap, xF, swapTab.ReinterpretCast<uint32_t>(), 0, cnt_);

        auto csB = csBBuf_.Get<float>();
        auto snB = snBBuf_.Get<float>();
        AscendC::Mul(xF, xF, csB, cnt_);
        AscendC::Mul(swap, swap, snB, cnt_);
        AscendC::Add(xF, xF, swap, cnt_);

        auto out = outQ_.AllocTensor<bfloat16_t>();
        AscendC::Cast(out, xF, AscendC::RoundMode::CAST_RINT, cnt_);
        outQ_.EnQue(out);
        auto outReady = outQ_.DeQue<bfloat16_t>();
        AscendC::DataCopyExtParams outParams{(uint16_t)h_,
                                             (uint32_t)(seg_ * sizeof(bfloat16_t)),
                                             0,
                                             (uint32_t)((d_ - seg_) *
                                                        sizeof(bfloat16_t)),
                                             0};
        AscendC::DataCopyPad(qGm_[base], outReady, outParams);
        outQ_.FreeTensor(outReady);
    }

    __aicore__ inline void Process()
    {
        if ASCEND_IS_AIC {
            return;
        }
        const int32_t block = GetBlockIdx();
        const int64_t units = (int64_t)b_ * s_;
        const int64_t per = (units + ROPE_BLOCKS - 1) / ROPE_BLOCKS;
        const int64_t uStart = (int64_t)block * per;
        int64_t uEnd = uStart + per;
        if (uEnd > units) {
            uEnd = units;
        }
        if (uStart >= uEnd) {
            return;
        }

        Prepare();
        int32_t lastS = -1;
        for (int64_t u = uStart; u < uEnd; ++u) {
            const int32_t sv = (int32_t)(u / b_);
            const int32_t bv = (int32_t)(u % b_);
            if (sv != lastS) {
                BuildCsSn(sv);
                lastS = sv;
            }
            ProcessUnit(bv, sv);
        }
    }

private:
    int32_t b_ = 0, s_ = 0, h_ = 0, d_ = 0, pairs_ = 0;
    int32_t seg_ = 0, cnt_ = 0;

    GlobalTensor<bfloat16_t> qGm_;
    GlobalTensor<float> freqsGm_;

    TQue<TPosition::VECIN, 2> inQ_;
    TQue<TPosition::VECOUT, 2> outQ_;
    TBuf<TPosition::VECCALC> xFBuf_;
    TBuf<TPosition::VECCALC> swapBuf_;
    TBuf<TPosition::VECCALC> csBBuf_;
    TBuf<TPosition::VECCALC> snBBuf_;
    TBuf<TPosition::VECCALC> freqBuf_;
    TBuf<TPosition::VECCALC> csBuf_;
    TBuf<TPosition::VECCALC> snBuf_;
    TBuf<TPosition::VECCALC> swapTabBuf_;
    TBuf<TPosition::VECCALC> csTabBuf_;
    TBuf<TPosition::VECCALC> snTabBuf_;
    TBuf<TPosition::VECCALC> signBuf_;
    TBuf<TPosition::VECCALC> bcastTmpBuf_;
};

extern "C" __global__ __aicore__ void indexer_rope_kernel(
    GM_ADDR q, GM_ADDR freqs, int32_t b, int32_t s, int32_t h, int32_t d,
    int32_t pairs)
{
    TPipe pipe;
    IndexerRopeKernel op;
    op.Init(q, freqs, b, s, h, d, pairs, &pipe);
    op.Process();
}
