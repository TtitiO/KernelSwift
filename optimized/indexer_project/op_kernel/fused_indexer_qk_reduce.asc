#include "kernel_operator.h"

using namespace AscendC;

static constexpr uint32_t CUBE_BLOCK = 16;
static constexpr uint32_t CUBE_BLOCK_SIZE = CUBE_BLOCK * CUBE_BLOCK;

// =========================================================
// T 被外层 Python Pad 到了 704 完美对齐
// =========================================================
static constexpr int32_t TILE_M = 64;   // 每次算 4 个 Token (64 行)
static constexpr int32_t TILE_K = 64;   // Head Dim
static constexpr int32_t TILE_N = 704;  // 704 是 64(Vector) 和 16(Cube) 的公倍数

static constexpr uint16_t FLAG_QK_READY = 1;
static constexpr uint16_t FLAG_AGG_READY = 2;

class FusedIndexerKernel {
public:
    __aicore__ inline void Init(GM_ADDR q, GM_ADDR kvT, GM_ADDR weights, 
                                GM_ADDR out, GM_ADDR workspace, uint32_t total_tiles) {
        this->total_tiles_ = total_tiles;
        
        q_gm_.SetGlobalBuffer((__gm__ bfloat16_t *)q);
        kvT_gm_.SetGlobalBuffer((__gm__ bfloat16_t *)kvT);
        weights_gm_.SetGlobalBuffer((__gm__ bfloat16_t *)weights);
        out_gm_.SetGlobalBuffer((__gm__ float *)out);
        
        // Workspace 用于 AIC -> AIV 传递数据，强行驻留 L2 Cache，消除 HBM 流量
        workspace_gm_.SetGlobalBuffer((__gm__ float *)workspace);

        if ASCEND_IS_AIC {
            pipe_.InitBuffer(inQueueA1_, 2, TILE_M * TILE_K * sizeof(bfloat16_t));
            pipe_.InitBuffer(inQueueA2_, 1, TILE_M * TILE_K * sizeof(bfloat16_t));
            pipe_.InitBuffer(inQueueB1_, 2, TILE_K * TILE_N * sizeof(bfloat16_t));
            pipe_.InitBuffer(inQueueB2_, 1, TILE_K * TILE_N * sizeof(bfloat16_t));
            pipe_.InitBuffer(outQueueCO1_, 1, TILE_M * TILE_N * sizeof(float));
        }

        if ASCEND_IS_AIV {
            pipe_.InitBuffer(scoresQ_, 2, 32 * TILE_N * sizeof(float));
            pipe_.InitBuffer(outQ_, 2, 2 * TILE_N * sizeof(float));
            pipe_.InitBuffer(weightsBuf_, 32 * sizeof(bfloat16_t));
            pipe_.InitBuffer(weightsFp32Buf_, 32 * sizeof(float));
        }
    }

    __aicore__ inline void Process() {
        if ASCEND_IS_AIC {
            ProcessAic();
        } else {
            ProcessAiv();
        }
    }

private:
    // ===================================================================
    // AIC (矩阵核)：计算 Q @ KVT (Depth-2 软件流水线)
    // ===================================================================
    __aicore__ inline void ProcessAic() {
        uint32_t core = GetBlockIdx();
        uint32_t core_tiles = (total_tiles_ + 19) / 20; // 假设 20 核拉满
        uint32_t start_tile = core * core_tiles;
        uint32_t end_tile = start_tile + core_tiles;
        if (end_tile > total_tiles_) end_tile = total_tiles_;
        if (start_tile >= end_tile) return;

        uint32_t n = end_tile - start_tile;

        // 流水线预加载第一块
        QkCopyIn(start_tile);
        QkSplit();
        
        for (uint32_t i = 0; i < n; ++i) {
            uint32_t t = start_tile + i;
            if (i + 1 < n) { QkCopyIn(t + 1); }
            
            Compute();
            
            if (i + 1 < n) { QkSplit(); }
            
            // 确保上一轮的 AIV 已经把 Workspace 读走了 (AIV0 和 AIV1 各发一个信号)
            if (i >= 2) {
                CrossCoreWaitFlag(FLAG_AGG_READY);
                CrossCoreWaitFlag(FLAG_AGG_READY);
            }
            
            // 输出到 Workspace 供 AIV 读取
            QkCopyOut(core, i % 2);
            
            // 通知 AIV 数据已备好 (发两次，分别给 AIV0 和 AIV1)
            CrossCoreSetFlag<2, PIPE_FIX>(FLAG_QK_READY);
            CrossCoreSetFlag<2, PIPE_FIX>(FLAG_QK_READY);
        }
    }

    // ---------------------------------------------
    // AIC 基础算子封装 (Nd2Nz + Mmad)
    // ---------------------------------------------
    __aicore__ inline uint32_t CeilBlock(uint32_t len) { return (len + CUBE_BLOCK - 1U) / CUBE_BLOCK; }

    __aicore__ inline void QkCopyIn(uint32_t t) {
        auto a1 = inQueueA1_.AllocTensor<bfloat16_t>();
        AscendC::Nd2NzParams pA;
        pA.ndNum = 1; pA.nValue = TILE_M; pA.dValue = TILE_K;
        pA.srcNdMatrixStride = 0; pA.srcDValue = TILE_K;
        pA.dstNzC0Stride = CeilBlock(TILE_M) * CUBE_BLOCK;
        pA.dstNzNStride = 1; pA.dstNzMatrixStride = 0;
        AscendC::DataCopy(a1, q_gm_[t * TILE_M * TILE_K], pA);
        inQueueA1_.EnQue(a1);

        uint32_t b = (t * TILE_M) / (2600 * 16); // 计算所属 Batch
        auto b1 = inQueueB1_.AllocTensor<bfloat16_t>();
        AscendC::Nd2NzParams pB;
        pB.ndNum = 1; pB.nValue = TILE_K; pB.dValue = TILE_N;
        pB.srcNdMatrixStride = 0; pB.srcDValue = TILE_N;
        pB.dstNzC0Stride = CeilBlock(TILE_K) * CUBE_BLOCK;
        pB.dstNzNStride = 1; pB.dstNzMatrixStride = 0;
        AscendC::DataCopy(b1, kvT_gm_[b * TILE_K * TILE_N], pB);
        inQueueB1_.EnQue(b1);
    }

    __aicore__ inline void QkSplit() {
        auto a1 = inQueueA1_.DeQue<bfloat16_t>();
        auto a2 = inQueueA2_.AllocTensor<bfloat16_t>();
        AscendC::LoadData2DParams pA;
        pA.repeatTimes = CeilBlock(TILE_K); pA.srcStride = CeilBlock(TILE_M); pA.dstGap = 0; pA.ifTranspose = false;
        for (uint32_t i = 0; i < CeilBlock(TILE_M); ++i) {
            AscendC::LoadData(a2[i * CeilBlock(TILE_K) * CUBE_BLOCK_SIZE], a1[i * CUBE_BLOCK_SIZE], pA);
        }
        inQueueA2_.EnQue<bfloat16_t>(a2);
        inQueueA1_.FreeTensor(a1);

        auto b1 = inQueueB1_.DeQue<bfloat16_t>();
        auto b2 = inQueueB2_.AllocTensor<bfloat16_t>();
        AscendC::LoadData2DParams pB;
        pB.repeatTimes = CeilBlock(TILE_N); pB.srcStride = CeilBlock(TILE_K); pB.dstGap = 0; pB.ifTranspose = true;
        for (uint32_t i = 0; i < CeilBlock(TILE_K); ++i) {
            AscendC::LoadData(b2[i * CeilBlock(TILE_N) * CUBE_BLOCK_SIZE], b1[i * CUBE_BLOCK_SIZE], pB);
        }
        inQueueB1_.FreeTensor(b1);
        inQueueB2_.EnQue<bfloat16_t>(b2);
    }

    __aicore__ inline void Compute() {
        auto a2 = inQueueA2_.DeQue<bfloat16_t>();
        auto b2 = inQueueB2_.DeQue<bfloat16_t>();
        auto c1 = outQueueCO1_.AllocTensor<float>();
        AscendC::MmadParams mp;
        mp.m = TILE_M; mp.n = TILE_N; mp.k = TILE_K; mp.cmatrixInitVal = true;
        AscendC::Mmad(c1, a2, b2, mp);
        outQueueCO1_.EnQue<float>(c1);
        inQueueA2_.FreeTensor(a2);
        inQueueB2_.FreeTensor(b2);
    }

    __aicore__ inline void QkCopyOut(uint32_t core, uint32_t pp) {
        auto c1 = outQueueCO1_.DeQue<float>();
        AscendC::FixpipeParamsV220 fp;
        fp.nSize = TILE_N; fp.mSize = TILE_M; fp.srcStride = TILE_M; fp.dstStride = TILE_N;
        fp.quantPre = QuantMode_t::NoQuant; fp.reluEn = false;
        fp.ndNum = 1; fp.srcNdStride = 0; fp.dstNdStride = 0;
        // 写入 Workspace：[20个核, 2缓冲, 64行, 704列]
        uint32_t ws_offset = (core * 2 + pp) * TILE_M * TILE_N;
        AscendC::Fixpipe<float, float>(workspace_gm_[ws_offset], c1, fp);
        outQueueCO1_.FreeTensor(c1);
    }


    // ===================================================================
    // AIV (向量核)：激活(ReLU) + 乘法 + 归约(ReduceSum)
    // ===================================================================
    __aicore__ inline void ProcessAiv() {
        uint32_t sub = AscendC::GetSubBlockIdx(); // 0 或 1
        uint32_t core = GetBlockIdx() / AscendC::GetSubBlockNum();
        
        uint32_t core_tiles = (total_tiles_ + 19) / 20;
        uint32_t start_tile = core * core_tiles;
        uint32_t end_tile = start_tile + core_tiles;
        if (end_tile > total_tiles_) end_tile = total_tiles_;
        if (start_tile >= end_tile) return;

        uint32_t n = end_tile - start_tile;

        // AIV0 负责前 32 行 (0~31), AIV1 负责后 32 行 (32~63)
        uint32_t row_start = sub * 32; 

        for (uint32_t i = 0; i < n; ++i) {
            uint32_t t = start_tile + i;
            uint32_t pp = i % 2;

            CrossCoreWaitFlag(FLAG_QK_READY);

            // 1. 从 L2 Workspace 读取属于自己的 32 行分数
            auto scores = scoresQ_.AllocTensor<float>();
            uint32_t ws_offset = (core * 2 + pp) * TILE_M * TILE_N + row_start * TILE_N;
            AscendC::DataCopy(scores, workspace_gm_[ws_offset], 32 * TILE_N);
            scoresQ_.EnQue(scores);

            // 读取完成后，立刻通知 AIC 这个位置可以覆盖了
            auto s_ready = scoresQ_.DeQue<float>();
            CrossCoreSetFlag<2, PIPE_MTE3>(FLAG_AGG_READY);

            // 2. 读取当前 32 行对应的 32 个头权重
            auto w_bf16 = weightsBuf_.Get<bfloat16_t>();
            auto w_fp32 = weightsFp32Buf_.Get<float>();
            AscendC::DataCopy(w_bf16, weights_gm_[t * TILE_M + row_start], 32);
            AscendC::Cast(w_fp32, w_bf16, AscendC::RoundMode::CAST_NONE, 32);

            // 3. 在 UB 里执行向量指令 (ReLU -> Mul -> Reduce)
            auto out = outQ_.AllocTensor<float>();
            ComputeReduce(s_ready, w_fp32, out);
            scoresQ_.FreeTensor(s_ready);
            outQ_.EnQue(out);

            // 4. 将输出 (2个 Token，2行) 写回最终的 Global Memory [B, S, T]
            auto out_ready = outQ_.DeQue<float>();
            uint32_t out_token_start = t * 4 + (sub * 2); 
            AscendC::DataCopy(out_gm_[out_token_start * TILE_N], out_ready, 2 * TILE_N);
            outQ_.FreeTensor(out_ready);
        }
    }

    __aicore__ inline void ComputeReduce(LocalTensor<float>& scores, LocalTensor<float>& w, LocalTensor<float>& out) {
        // 1. ReLU 激活 (全尺寸 100% 对齐)
        AscendC::Max(scores, scores, 0.0f, 32 * TILE_N);

        // 2. 乘以各个头的权重 (每行乘以一个标量)
        for (uint32_t r = 0; r < 32; ++r) {
            float weight_scalar = w.GetValue(r);
            AscendC::Muls(scores[r * TILE_N], scores[r * TILE_N], weight_scalar, TILE_N);
        }

        // 3. 规约累加 (16 头合成 1 个 Token)
        // 第 1 个 Token (前 16 行)
        AscendC::Duplicate(out[0], 0.0f, TILE_N);
        for (uint32_t r = 0; r < 16; ++r) {
            AscendC::Add(out[0], out[0], scores[r * TILE_N], TILE_N);
        }
        // 第 2 个 Token (后 16 行)
        AscendC::Duplicate(out[TILE_N], 0.0f, TILE_N);
        for (uint32_t r = 16; r < 32; ++r) {
            AscendC::Add(out[TILE_N], out[TILE_N], scores[r * TILE_N], TILE_N);
        }
    }

    uint32_t total_tiles_;

    GlobalTensor<bfloat16_t> q_gm_;
    GlobalTensor<bfloat16_t> kvT_gm_;
    GlobalTensor<bfloat16_t> weights_gm_;
    GlobalTensor<float> out_gm_;
    GlobalTensor<float> workspace_gm_;

    TPipe pipe_;
    // AIC Queues
    TQue<TPosition::A1, 2> inQueueA1_;
    TQue<TPosition::A2, 1> inQueueA2_;
    TQue<TPosition::B1, 2> inQueueB1_;
    TQue<TPosition::B2, 1> inQueueB2_;
    TQue<TPosition::CO1, 1> outQueueCO1_;
    // AIV Queues
    TQue<TPosition::VECIN, 2> scoresQ_;
    TQue<TPosition::VECOUT, 2> outQ_;
    TBuf<TPosition::VECCALC> weightsBuf_;
    TBuf<TPosition::VECCALC> weightsFp32Buf_;
};

extern "C" __global__ __mix__(1, 2) void fused_indexer_qk_reduce(
    GM_ADDR q, GM_ADDR kvT, GM_ADDR weights, GM_ADDR out, GM_ADDR workspace, uint32_t total_tiles) {
    FusedIndexerKernel op;
    op.Init(q, kvT, weights, out, workspace, total_tiles);
    op.Process();
}
