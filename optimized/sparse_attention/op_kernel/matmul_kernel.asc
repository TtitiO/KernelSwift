// ============================================================================
// SparseAttention Cube GEMMs (MatmulImpl) — QK and PV.
//   QK : scores[N_kv, M*H] = kv[N_kv, D] @ q^T[D, M*H]   (BF16 x BF16 -> FP32)
//   PV : out[M*H, D]        = agg^T[M*H, N_kv] @ kv[N_kv, D] (BF16 x BF16 -> BF16)
// Intermediate layout is [B, N, M, H] (n-major) so both GEMMs are natural and
// the softmax kernel reads/writes contiguous [N, H] blocks.
// ============================================================================

#include "kernel_operator.h"
#include "lib/matmul_intf.h"
#include "sparse_attn_tiling.h"

using namespace AscendC;

// MDL config with fixpipe write-back (enUnitFlag=true).
constexpr MatmulConfig MM_CFG_NO_PRELOAD =
    GetMDLConfig(false, false, 2, false, false, false, true);

// ---------------------------------------------------------------------------
// Copy a tiling POD from GM to a stack-resident struct (never via UB/L1).
// ---------------------------------------------------------------------------
template <typename HeaderT>
__aicore__ inline void LoadTilingFromGM(GM_ADDR tilingGM, HeaderT &dstStack)
{
    static_assert(alignof(HeaderT) % sizeof(int32_t) == 0,
                  "TilingHeader must be 4-byte aligned");
    constexpr uint32_t HEADER_INTS =
        (sizeof(HeaderT) + sizeof(int32_t) - 1U) / sizeof(int32_t);
    const auto *gmInts  = reinterpret_cast<const __gm__ int32_t *>(tilingGM);
    auto       *dstInts = reinterpret_cast<int32_t *>(&dstStack);
    for (uint32_t i = 0; i < HEADER_INTS; ++i) {
        dstInts[i] = gmInts[i];
    }
}

// ---------------------------------------------------------------------------
// Shared driver.  TRANS_A / TRANS_B select the operand storage orientation.
// ---------------------------------------------------------------------------
template <typename AT, typename CT, bool TRANS_A, bool TRANS_B>
class MatmulKernel {
public:
    using A_TYPE = MatmulType<TPosition::GM, CubeFormat::ND, AT, TRANS_A>;
    using B_TYPE = MatmulType<TPosition::GM, CubeFormat::ND, AT, TRANS_B>;
    using C_TYPE = MatmulType<TPosition::GM, CubeFormat::ND, CT>;
    using BIAS_TYPE = MatmulType<TPosition::GM, CubeFormat::ND, float>;

    __aicore__ inline void Init(GM_ADDR a, GM_ADDR b, GM_ADDR c, GM_ADDR tilingGM,
                                TPipe *pipe)
    {
        if ASCEND_IS_AIV {
            return;
        }
        pipe_ = pipe;
        LoadTilingFromGM<SparseMatmulTiling>(tilingGM, tiling_);

        const int64_t aElems = (int64_t)tiling_.batchNum * tiling_.aBatchStride;
        const int64_t bElems = (int64_t)tiling_.batchNum * tiling_.bBatchStride;
        const int64_t cElems = (int64_t)tiling_.batchNum * tiling_.cBatchStride;

        aGm_.SetGlobalBuffer((__gm__ AT *)a, (uint64_t)aElems);
        bGm_.SetGlobalBuffer((__gm__ AT *)b, (uint64_t)bElems);
        cGm_.SetGlobalBuffer((__gm__ CT *)c, (uint64_t)cElems);

        const int64_t grid = (int64_t)tiling_.batchNum * tiling_.totalBlock;
        const int32_t blockIdx = GetBlockIdx();
        workStart_ = (int64_t)blockIdx * tiling_.workPerBlock;
        workEnd_ = workStart_ + tiling_.workPerBlock;
        if (workEnd_ > grid) {
            workEnd_ = grid;
        }

        mm_.SetSubBlockIdx(0);
        mm_.Init(&tiling_.cubeTiling, pipe);
        mm_.SetHF32(false, 0);
    }

    __aicore__ inline void Process()
    {
        if ASCEND_IS_AIV {
            return;
        }
        const int32_t singleM = tiling_.cubeTiling.singleCoreM;
        const int32_t singleN = tiling_.cubeTiling.singleCoreN;
        const int32_t K = tiling_.cubeTiling.Ka;
        const int32_t N = tiling_.cubeTiling.N;

        for (int64_t w = workStart_; w < workEnd_; w++) {
            const int32_t batch = (int32_t)(w / tiling_.totalBlock);
            const int32_t tile  = (int32_t)(w % tiling_.totalBlock);
            const int32_t mIdx  = tile / tiling_.nTotalCnt;
            const int32_t nIdx  = tile % tiling_.nTotalCnt;

            const int32_t curM = (mIdx == tiling_.mTotalCnt - 1) ? tiling_.mBaseTail : singleM;
            const int32_t curN = (nIdx == tiling_.nTotalCnt - 1) ? tiling_.nBaseTail : singleN;

            // A offset.  TRANS_A: stored [K, M] (column offset); else [M, K] (row offset).
            const int64_t aOff = (int64_t)batch * tiling_.aBatchStride +
                                 (TRANS_A ? (int64_t)mIdx * singleM
                                          : (int64_t)mIdx * singleM * K);
            // B offset.  TRANS_B: stored [N, K] (row offset); else [K, N] (column offset).
            const int64_t bOff = (int64_t)batch * tiling_.bBatchStride +
                                 (TRANS_B ? (int64_t)nIdx * singleN * K
                                          : (int64_t)nIdx * singleN);
            // C is always [M, N] row-major.
            const int64_t cOff = (int64_t)batch * tiling_.cBatchStride +
                                 (int64_t)mIdx * singleM * N + (int64_t)nIdx * singleN;

            mm_.SetSingleShape(curM, curN, K);
            mm_.SetTensorA(aGm_[aOff], TRANS_A);
            mm_.SetTensorB(bGm_[bOff], TRANS_B);
            mm_.IterateAll(cGm_[cOff], 0);
        }
        PipeBarrier<PIPE_ALL>();
    }

private:
    TPipe *pipe_ = nullptr;
    SparseMatmulTiling tiling_;
    int64_t workStart_ = 0;
    int64_t workEnd_ = 0;
    GlobalTensor<AT> aGm_;
    GlobalTensor<AT> bGm_;
    GlobalTensor<CT> cGm_;
    MatmulImpl<A_TYPE, B_TYPE, C_TYPE, BIAS_TYPE, MM_CFG_NO_PRELOAD> mm_;
};

// ---------------------------------------------------------------------------
// Entry points
// ---------------------------------------------------------------------------
extern "C" __global__ __aicore__ void matmul_qk_kernel(
    GM_ADDR a, GM_ADDR b, GM_ADDR c, GM_ADDR tiling)
{
    TPipe pipe;
    MatmulKernel<bfloat16_t, half, false, true> op;
    op.Init(a, b, c, tiling, &pipe);
    op.Process();
}

extern "C" __global__ __aicore__ void matmul_pv_kernel(
    GM_ADDR a, GM_ADDR b, GM_ADDR c, GM_ADDR tiling)
{
    TPipe pipe;
    MatmulKernel<bfloat16_t, bfloat16_t, false, false> op;
    op.Init(a, b, c, tiling, &pipe);
    op.Process();
}
