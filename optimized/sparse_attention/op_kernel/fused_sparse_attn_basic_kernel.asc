// ============================================================================
// Fused sparse-attention megakernel implemented with the basic Ascend C cube
// API (DataCopy/Nd2Nz + LoadData + Mmad + Fixpipe) instead of the high-level
// KFC Matmul objects.
//
//   __mix__(1,2): AIC runs the cube stages (CopyIn, SplitA/B, Compute,
//   CopyOut) for QK and PV; AIV runs the sink-aware sparse softmax.  AIC and
//   AIV synchronize with CrossCoreSetFlag / CrossCoreWaitFlag (mode 2).
//
// Current megakernel: blockDim = AI cores, both AIV sub-blocks participate.
// The tile loop is partitioned across all cube cores; QK tiles are pipelined
// ahead of the AIV softmax, and PV tiles follow the AIV completion handshake.
// ============================================================================
#include "kernel_operator.h"
#include "adv_api/pad/broadcast.h"
#include "adv_api/reduce/reduce.h"
#include "sparse_attn_tiling.h"

using namespace AscendC;

static constexpr float NEG_INF_HALF = -60000.0f;
static constexpr int32_t ROWS = 4;
static constexpr int32_t TILE_M = ROWS * 64;  // 256 (m,h) rows per tile

static constexpr uint32_t CUBE_BLOCK = 16;
static constexpr uint32_t CUBE_BLOCK_SIZE = CUBE_BLOCK * CUBE_BLOCK;

static constexpr uint16_t FLAG_QK_READY = 1;
static constexpr uint16_t FLAG_AGG_READY = 2;

static constexpr int32_t FLAG_BATCH = 2;   // cross-core flags are batched

class FusedSparseAttnBasicKernel {
public:
    __aicore__ inline void Init(GM_ADDR q, GM_ADDR kv, GM_ADDR kvT,
                                GM_ADDR sink, GM_ADDR topk,
                                GM_ADDR scores, GM_ADDR agg, GM_ADDR out,
                                GM_ADDR tilingGM, TPipe *pipe)
    {
        pipe_ = pipe;
        LoadTilingFromGM<FusedSparseAttnBasicTiling>(tilingGM, tiling_);
        h_ = tiling_.h;
        n_ = tiling_.n;
        d_ = tiling_.d;
        topk_ = tiling_.topk;
        scale_ = tiling_.scale;
        mPerBatch_ = tiling_.mPerBatch;

        qGm_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(q),
                             (uint64_t)tiling_.totalTiles * TILE_M * d_);
        kvGm_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(kv),
                              (uint64_t)tiling_.batchNum * n_ * d_);
        kvTGm_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(kvT),
                               (uint64_t)tiling_.batchNum * d_ * n_);
        scoresGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(scores),
                                  (uint64_t)tiling_.totalTiles * TILE_M * n_);
        aggGm_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(agg),
                               (uint64_t)tiling_.totalTiles * TILE_M * n_);
        outGm_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(out),
                               (uint64_t)tiling_.totalTiles * TILE_M * d_);
        topkGm_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(topk),
                                (uint64_t)tiling_.totalTiles * ROWS * topk_);
        sinkGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(sink), h_);

        if ASCEND_IS_AIC {
            const uint32_t maxA = TILE_M * d_;        // QK A: [256,128]
            const uint32_t maxB = d_ * n_;            // QK B: [128,32]
            const uint32_t maxC = TILE_M * d_;        // PV C: [256,128]
            // A/B queues are double-buffered: while the cube computes tile t,
            // the MTE can already be loading tile t+1 into the other slot.
            pipe_->InitBuffer(inQueueA1_, 2, maxA * sizeof(bfloat16_t));
            pipe_->InitBuffer(inQueueA2_, 1, maxA * sizeof(bfloat16_t));
            pipe_->InitBuffer(inQueueB1_, 2, maxB * sizeof(bfloat16_t));
            pipe_->InitBuffer(inQueueB2_, 1, maxB * sizeof(bfloat16_t));
            pipe_->InitBuffer(outQueueCO1_, 1, maxC * sizeof(float));
        }

        if ASCEND_IS_AIV {
            // Ping-pong queues for scores/indices and the transposed agg tile.
            pipe_->InitBuffer(scoresQ_, 2, 2 * h_ * n_ * sizeof(float));
            pipe_->InitBuffer(idxQ_, 2, ROWS * topk_ * sizeof(int32_t));
            pipe_->InitBuffer(aggOutQ_, 2, TILE_M * n_ * sizeof(bfloat16_t));
            pipe_->InitBuffer(sKBuf_, 2 * topk_ * TILE_M / 2 * sizeof(float));
            // Aggregation stays FP32 (Add has no bf16 on v220; fp16 casts are
            // unwired on this backend), with one final FP32->BF16 Cast before
            // the transpose gather feeding the BF16 PV GEMM.
            pipe_->InitBuffer(aggTBuf_, ROWS * n_ * h_ * sizeof(float));
            pipe_->InitBuffer(aggTbf16Buf_, ROWS * n_ * h_ * sizeof(bfloat16_t));
            pipe_->InitBuffer(maxBuf_, TILE_M * sizeof(float));
            pipe_->InitBuffer(sumBuf_, TILE_M * sizeof(float));
            pipe_->InitBuffer(recipBuf_, TILE_M * sizeof(float));
            // [topk, vecLen] broadcast scratch (doubled: disjoint per sub-block),
            // reused for both the maxH and the reciprocal broadcasts.
            pipe_->InitBuffer(maxH2Buf_, 2 * topk_ * TILE_M / 2 * sizeof(float));
            pipe_->InitBuffer(bcastTmpBuf_, 2 * 256 * sizeof(uint8_t));
            pipe_->InitBuffer(sinkBroadcastBuf_, TILE_M * sizeof(float));
            pipe_->InitBuffer(sinkBuf_, h_ * sizeof(float));
            pipe_->InitBuffer(offsetTableBuf_, n_ * h_ * sizeof(int32_t));
            pipe_->InitBuffer(baseForwardBuf_, h_ * sizeof(int32_t));
            pipe_->InitBuffer(baseReverseBuf_, n_ * sizeof(int32_t));
            pipe_->InitBuffer(revOffsetBuf_, n_ * h_ * sizeof(int32_t));
        }
    }

    __aicore__ inline void Process()
    {
        if ASCEND_IS_AIC {
            ProcessAic();
        } else {
            ProcessAiv();
        }
    }

private:
    // ------------------------------------------------------------------
    // AIC: basic cube pipeline
    // ------------------------------------------------------------------
    __aicore__ inline uint32_t CeilCubeBlock(uint32_t len)
    {
        return (len + CUBE_BLOCK - 1U) / CUBE_BLOCK;
    }

    template <typename T>
    __aicore__ inline void CopyInA(GlobalTensor<T> &gm, uint64_t off,
                                   uint32_t m, uint32_t k)
    {
        auto a1 = inQueueA1_.AllocTensor<T>();
        AscendC::Nd2NzParams p;
        p.ndNum = 1;
        p.nValue = m;
        p.dValue = k;
        p.srcNdMatrixStride = 0;
        p.srcDValue = k;
        p.dstNzC0Stride = CeilCubeBlock(m) * CUBE_BLOCK;
        p.dstNzNStride = 1;
        p.dstNzMatrixStride = 0;
        AscendC::DataCopy(a1, gm[off], p);
        inQueueA1_.EnQue(a1);
    }

    template <typename T>
    __aicore__ inline void CopyInB(GlobalTensor<T> &gm, uint64_t off,
                                   uint32_t k, uint32_t n)
    {
        auto b1 = inQueueB1_.AllocTensor<T>();
        AscendC::Nd2NzParams p;
        p.ndNum = 1;
        p.nValue = k;
        p.dValue = n;
        p.srcNdMatrixStride = 0;
        p.srcDValue = n;
        p.dstNzC0Stride = CeilCubeBlock(k) * CUBE_BLOCK;
        p.dstNzNStride = 1;
        p.dstNzMatrixStride = 0;
        AscendC::DataCopy(b1, gm[off], p);
        inQueueB1_.EnQue(b1);
    }

    template <typename T>
    __aicore__ inline void SplitA(uint32_t m, uint32_t k)
    {
        auto a1 = inQueueA1_.DeQue<T>();
        auto a2 = inQueueA2_.AllocTensor<T>();

        uint32_t dstOffset = CeilCubeBlock(k) * CUBE_BLOCK_SIZE;
        uint32_t srcOffset = CUBE_BLOCK_SIZE;
        AscendC::LoadData2DParams p;
        p.repeatTimes = CeilCubeBlock(k);
        p.srcStride = CeilCubeBlock(m);
        p.dstGap = 0;
        p.ifTranspose = false;
        for (uint32_t i = 0; i < CeilCubeBlock(m); ++i) {
            AscendC::LoadData(a2[i * dstOffset], a1[i * srcOffset], p);
        }

        inQueueA2_.EnQue<T>(a2);
        inQueueA1_.FreeTensor(a1);
    }

    template <typename T>
    __aicore__ inline void SplitB(uint32_t k, uint32_t n)
    {
        auto b1 = inQueueB1_.DeQue<T>();
        auto b2 = inQueueB2_.AllocTensor<T>();

        uint32_t dstOffset = CeilCubeBlock(n) * CUBE_BLOCK_SIZE;
        uint32_t srcOffset = CUBE_BLOCK_SIZE;
        AscendC::LoadData2DParams p;
        p.repeatTimes = CeilCubeBlock(n);
        p.srcStride = CeilCubeBlock(k);
        p.dstGap = 0;
        p.ifTranspose = true;
        for (uint32_t i = 0; i < CeilCubeBlock(k); ++i) {
            AscendC::LoadData(b2[i * dstOffset], b1[i * srcOffset], p);
        }

        inQueueB1_.FreeTensor(b1);
        inQueueB2_.EnQue<T>(b2);
    }

    template <typename T>
    __aicore__ inline void Compute(uint32_t m, uint32_t n, uint32_t k)
    {
        auto a2 = inQueueA2_.DeQue<T>();
        auto b2 = inQueueB2_.DeQue<T>();
        auto c1 = outQueueCO1_.AllocTensor<float>();
        AscendC::MmadParams mp;
        mp.m = m;
        mp.n = n;
        mp.k = k;
        mp.cmatrixInitVal = true;
        AscendC::Mmad(c1, a2, b2, mp);
        outQueueCO1_.EnQue<float>(c1);
        inQueueA2_.FreeTensor(a2);
        inQueueB2_.FreeTensor(b2);
    }

    __aicore__ inline void CopyOutFp32(GlobalTensor<float> &gm, uint64_t off,
                                       uint32_t m, uint32_t n)
    {
        auto c1 = outQueueCO1_.DeQue<float>();
        AscendC::FixpipeParamsV220 fp;
        fp.nSize = n;
        fp.mSize = m;
        fp.srcStride = m;
        fp.dstStride = n;
        fp.quantPre = QuantMode_t::NoQuant;
        fp.reluEn = false;
        fp.ndNum = 1;
        fp.srcNdStride = 0;
        fp.dstNdStride = 0;
        AscendC::Fixpipe<float, float>(gm[off], c1, fp);
        outQueueCO1_.FreeTensor(c1);
    }

    __aicore__ inline void CopyOutBf16(GlobalTensor<bfloat16_t> &gm, uint64_t off,
                                       uint32_t m, uint32_t n)
    {
        auto c1 = outQueueCO1_.DeQue<float>();
        AscendC::FixpipeParamsV220 fp;
        fp.nSize = n;
        fp.mSize = m;
        fp.srcStride = m;
        fp.dstStride = n;
        fp.quantPre = QuantMode_t::F322BF16;
        fp.reluEn = false;
        fp.ndNum = 1;
        fp.srcNdStride = 0;
        fp.dstNdStride = 0;
        AscendC::Fixpipe<bfloat16_t, float>(gm[off], c1, fp);
        outQueueCO1_.FreeTensor(c1);
    }

    __aicore__ inline void QkMmad(int64_t t)
    {
        const int32_t b = (int32_t)((t * ROWS) / mPerBatch_);
        CopyInA(qGm_, (uint64_t)t * TILE_M * d_, TILE_M, d_);
        CopyInB(kvTGm_, (uint64_t)b * d_ * n_, d_, n_);
        SplitA<bfloat16_t>(TILE_M, d_);
        SplitB<bfloat16_t>(d_, n_);
        Compute<bfloat16_t>(TILE_M, n_, d_);
        CopyOutFp32(scoresGm_, (uint64_t)t * TILE_M * n_, TILE_M, n_);
    }

    __aicore__ inline void PvMmad(int64_t t)
    {
        const int32_t b = (int32_t)((t * ROWS) / mPerBatch_);
        CopyInA(aggGm_, (uint64_t)t * TILE_M * n_, TILE_M, n_);
        CopyInB(kvGm_, (uint64_t)b * n_ * d_, n_, d_);
        SplitA<bfloat16_t>(TILE_M, n_);
        SplitB<bfloat16_t>(n_, d_);
        Compute<bfloat16_t>(TILE_M, d_, n_);
        CopyOutBf16(outGm_, (uint64_t)t * TILE_M * d_, TILE_M, d_);
    }

    // Split QK/PV into separate pipeline stages so the AIC queues can
    // double-buffer the GM->L1 copies.  The pipeline function issues the next
    // tile's CopyIn before computing the current tile, letting MTE overlap the
    // Cube Mmad.
    __aicore__ inline void QkCopyIn(int64_t t)
    {
        const int32_t b = (int32_t)((t * ROWS) / mPerBatch_);
        CopyInA(qGm_, (uint64_t)t * TILE_M * d_, TILE_M, d_);
        CopyInB(kvTGm_, (uint64_t)b * d_ * n_, d_, n_);
    }

    __aicore__ inline void QkSplit(int64_t t)
    {
        SplitA<bfloat16_t>(TILE_M, d_);
        SplitB<bfloat16_t>(d_, n_);
    }

    __aicore__ inline void QkCompute(int64_t t)
    {
        Compute<bfloat16_t>(TILE_M, n_, d_);
    }

    __aicore__ inline void QkCopyOut(int64_t t)
    {
        CopyOutFp32(scoresGm_, (uint64_t)t * TILE_M * n_, TILE_M, n_);
    }

    __aicore__ inline void PvCopyIn(int64_t t)
    {
        const int32_t b = (int32_t)((t * ROWS) / mPerBatch_);
        CopyInA(aggGm_, (uint64_t)t * TILE_M * n_, TILE_M, n_);
        CopyInB(kvGm_, (uint64_t)b * n_ * d_, n_, d_);
    }

    __aicore__ inline void PvSplit(int64_t t)
    {
        SplitA<bfloat16_t>(TILE_M, n_);
        SplitB<bfloat16_t>(n_, d_);
    }

    __aicore__ inline void PvCompute(int64_t t)
    {
        Compute<bfloat16_t>(TILE_M, d_, n_);
    }

    __aicore__ inline void PvCopyOut(int64_t t)
    {
        CopyOutBf16(outGm_, (uint64_t)t * TILE_M * d_, TILE_M, d_);
    }

    __aicore__ inline void QkPipeline(int64_t start, int64_t end)
    {
        const int64_t n = end - start;
        if (n <= 0) {
            return;
        }
        QkCopyIn(start);
        QkSplit(start);
        for (int64_t i = 0; i < n; ++i) {
            const int64_t t = start + i;
            if (i + 1 < n) {
                QkCopyIn(t + 1);
            }
            QkCompute(t);
            if (i + 1 < n) {
                QkSplit(t + 1);
            }
            QkCopyOut(t);
        }
    }

    __aicore__ inline void PvPipeline(int64_t start, int64_t end)
    {
        const int64_t n = end - start;
        if (n <= 0) {
            return;
        }
        PvCopyIn(start);
        PvSplit(start);
        for (int64_t i = 0; i < n; ++i) {
            const int64_t t = start + i;
            if (i + 1 < n) {
                PvCopyIn(t + 1);
            }
            PvCompute(t);
            if (i + 1 < n) {
                PvSplit(t + 1);
            }
            PvCopyOut(t);
        }
    }

    __aicore__ inline int64_t BatchStart(int64_t tStart, int64_t b) const
    {
        return tStart + b * FLAG_BATCH;
    }

    __aicore__ inline int64_t BatchEnd(int64_t tStart, int64_t tEnd, int64_t b) const
    {
        int64_t end = BatchStart(tStart, b) + FLAG_BATCH;
        return end > tEnd ? tEnd : end;
    }

    __aicore__ inline void RunQkBatch(int64_t tStart, int64_t tEnd, int64_t b)
    {
        const int64_t bs = BatchStart(tStart, b);
        const int64_t be = BatchEnd(tStart, tEnd, b);
        QkPipeline(bs, be);
        AscendC::CrossCoreSetFlag<2, PIPE_FIX>(FLAG_QK_READY);
    }

    __aicore__ inline void RunPvBatch(int64_t tStart, int64_t tEnd, int64_t b)
    {
        const int64_t bs = BatchStart(tStart, b);
        const int64_t be = BatchEnd(tStart, tEnd, b);
        PvPipeline(bs, be);
    }

    __aicore__ inline void ProcessAic()
    {
        const int32_t core = GetBlockIdx();
        const int64_t tilesPerCore =
            (tiling_.totalTiles + tiling_.blockNum - 1) / tiling_.blockNum;
        const int64_t tStart = (int64_t)core * tilesPerCore;
        int64_t tEnd = tStart + tilesPerCore;
        if (tEnd > tiling_.totalTiles) {
            tEnd = tiling_.totalTiles;
        }
        if (tStart >= tEnd) {
            return;
        }
        const int64_t nTile = tEnd - tStart;
        const int64_t nBatch = (nTile + FLAG_BATCH - 1) / FLAG_BATCH;

        // Two QK batches are issued before the first AIV batch is consumed:
        // this is the batched form of the old depth-2 QK lookahead pipeline.
        RunQkBatch(tStart, tEnd, 0);
        if (nBatch >= 2) {
            RunQkBatch(tStart, tEnd, 1);
        }

        for (int64_t b = 0; b < nBatch; ++b) {
            // Issue QK(batch+2) while the AIVs still run softmax for batch b.
            if (b + 2 < nBatch) {
                RunQkBatch(tStart, tEnd, b + 2);
            }
            AscendC::CrossCoreWaitFlag(FLAG_AGG_READY);
            RunPvBatch(tStart, tEnd, b);
        }
    }

    // ------------------------------------------------------------------
    // AIV: sink-aware sparse softmax with ping-pong MTE prefetch and
    // batched cross-core flags.
    // ------------------------------------------------------------------
    __aicore__ inline void ProcessAiv()
    {
        // Each AI core has two AIV sub-blocks.  Both consume the AIC QK flag
        // and both signal AGG when done.  AIV0 processes the first half of
        // every tile's (m,h) rows, AIV1 the second half.
        const int32_t sub = AscendC::GetSubBlockIdx();
        const int32_t core = GetBlockIdx() / AscendC::GetSubBlockNum();
        const int64_t tilesPerCore =
            (tiling_.totalTiles + tiling_.blockNum - 1) / tiling_.blockNum;
        const int64_t tStart = (int64_t)core * tilesPerCore;
        int64_t tEnd = tStart + tilesPerCore;
        if (tEnd > tiling_.totalTiles) {
            tEnd = tiling_.totalTiles;
        }
        if (tStart >= tEnd) {
            return;
        }

        const int32_t rowStart = sub * 2;  // 0 or 2 (two m-rows per AIV)
        const int32_t rows = 2;
        const int64_t nTile = tEnd - tStart;
        const int64_t nBatch = (nTile + FLAG_BATCH - 1) / FLAG_BATCH;

        PrepareSoftmax();

        for (int64_t b = 0; b < nBatch; ++b) {
            AscendC::CrossCoreWaitFlag(FLAG_QK_READY);

            const int64_t bs = BatchStart(tStart, b);
            const int64_t be = BatchEnd(tStart, tEnd, b);
            const int64_t batchCount = be - bs;

            // Ping-pong prefetch within a batch: load tile i+1 before the
            // vector unit computes tile i.
            PrefetchScoresIdx(bs, rowStart, rows);
            for (int64_t i = 0; i < batchCount; ++i) {
                const int64_t t = bs + i;
                if (i > 0) {
                    WriteAggOut(t - 1, rowStart, rows);
                }
                if (i + 1 < batchCount) {
                    PrefetchScoresIdx(t + 1, rowStart, rows);
                }
                ComputeSoftmaxFromQueues(t, rowStart, rows, sub);
            }
            WriteAggOut(be - 1, rowStart, rows);

            // All batch writes must be visible to the AIC before signalling.
            AscendC::PipeBarrier<PIPE_MTE3>();
            AscendC::CrossCoreSetFlag<2, PIPE_MTE3>(FLAG_AGG_READY);
        }
    }

    __aicore__ inline void PrepareSoftmax()
    {
        auto sink = sinkBuf_.Get<float>();
        AscendC::DataCopyExtParams sinkParams{1, (uint32_t)(h_ * sizeof(float)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<float> sinkPad{false, 0, 0, 0.0f};
        AscendC::DataCopyPad(sink, sinkGm_, sinkParams, sinkPad);
        AscendC::PipeBarrier<PIPE_ALL>();

        auto sinkBroadcast = sinkBroadcastBuf_.Get<float>();
        for (int32_t r = 0; r < ROWS; r++) {
            AscendC::Adds<float>(sinkBroadcast[(int64_t)r * h_], sink, 0.0f, h_);
        }

        auto baseForward = baseForwardBuf_.Get<int32_t>();
        for (int32_t hh = 0; hh < h_; hh++) {
            baseForward.SetValue(hh, (int32_t)(hh * n_ * sizeof(float)));
        }
        auto offsetTable = offsetTableBuf_.Get<int32_t>();
        for (int32_t nn = 0; nn < n_; nn++) {
            AscendC::Adds<int32_t>(offsetTable[(int64_t)nn * h_], baseForward,
                                   (int32_t)(nn * sizeof(float)), h_);
        }

        auto baseReverse = baseReverseBuf_.Get<int32_t>();
        for (int32_t nn = 0; nn < n_; nn++) {
            baseReverse.SetValue(nn, (int32_t)(nn * h_ * sizeof(bfloat16_t)));
        }
        // Per-row transpose table: offset[h*n + nn] = nn*h*2B + h*2B.  The row
        // base is applied via the per-row src/dst pointers of the Gather, so a
        // single 2048-entry table serves all four rows (saves 24KB of UB).
        auto revOffset = revOffsetBuf_.Get<int32_t>();
        for (int32_t hh = 0; hh < h_; hh++) {
            AscendC::Adds<int32_t>(revOffset[(int64_t)hh * n_], baseReverse,
                                   (int32_t)(hh * sizeof(bfloat16_t)), n_);
        }
        AscendC::PipeBarrier<PIPE_ALL>();
    }

    __aicore__ inline void PrefetchScoresIdx(int64_t t, int32_t rowStart,
                                            int32_t rows)
    {
        const int64_t cOff = t * TILE_M * n_;
        const int64_t rowNOff = (int64_t)rowStart * h_ * n_;

        auto scoresUB = scoresQ_.AllocTensor<float>();
        AscendC::DataCopyExtParams scParams{1, (uint32_t)(rows * h_ * n_ * sizeof(float)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<float> scPad{false, 0, 0, 0.0f};
        AscendC::DataCopyPad(scoresUB, scoresGm_[cOff + rowNOff], scParams, scPad);
        scoresQ_.EnQue(scoresUB);

        auto idx = idxQ_.AllocTensor<int32_t>();
        AscendC::DataCopyExtParams idxParams{1, (uint32_t)(rows * topk_ * sizeof(int32_t)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<int32_t> idxPad{false, 0, 0, 0};
        AscendC::DataCopyPad(idx, topkGm_[t * ROWS * topk_ + rowStart * topk_], idxParams, idxPad);
        idxQ_.EnQue(idx);
    }

    __aicore__ inline void ComputeSoftmaxFromQueues(int64_t t,
                                                    int32_t rowStart,
                                                    int32_t rows,
                                                    int32_t sub)
    {
        const int64_t rowOff = (int64_t)rowStart * h_;
        const int64_t rowNOff = (int64_t)rowStart * h_ * n_;
        const int32_t vecLen = rows * h_;
        const int32_t kN = rows * n_ * h_;
        // Each AIV sub-block owns a private compact [topk, vecLen] sK region
        // (disjoint across sub-blocks) so cast/scale can run batched.
        const int32_t sKBase = sub * (topk_ * vecLen);

        auto scoresUB = scoresQ_.DeQue<float>();
        auto idx = idxQ_.DeQue<int32_t>();

        // 2. Gather the selected columns (fp32 scores) directly into this
        //    AIV's compact [topk, vecLen] sK tile.
        auto sK = sKBuf_.Get<float>();
        auto offsetTable = offsetTableBuf_.Get<int32_t>();
        int32_t nk[2][16];
        for (int32_t r = 0; r < rows; r++) {
            const int32_t row = rowStart + r;
            #pragma unroll
            for (int32_t k = 0; k < topk_; k++) {
                nk[r][k] = idx.GetValue(r * topk_ + k);
            }
            #pragma unroll
            for (int32_t k = 0; k < topk_; k++) {
                if (nk[r][k] >= 0 && nk[r][k] < n_) {
                    auto offK = offsetTable[(int64_t)nk[r][k] * h_].ReinterpretCast<uint32_t>();
                    AscendC::Gather(sK[sKBase + (int64_t)k * vecLen + (int64_t)r * h_],
                                    scoresUB[(int64_t)r * h_ * n_],
                                    offK, 0, (uint32_t)h_);
                } else {
                    AscendC::Duplicate<float>(sK[sKBase + (int64_t)k * vecLen + (int64_t)r * h_],
                                              NEG_INF_HALF, h_);
                }
            }
        }
        scoresQ_.FreeTensor(scoresUB);

        const int32_t sKLen = topk_ * vecLen;
        AscendC::Muls<float>(sK[sKBase], sK[sKBase], scale_, sKLen);

        // 3. Batched sink-aware softmax for this AIV's rows.  The compact
        //    [topk, vecLen] sK tile lets the subtract/exp/mul run batched over
        //    the whole tile after one Brcb broadcast of maxH / reciprocal.
        auto maxH = maxBuf_.Get<float>();
        auto sumH = sumBuf_.Get<float>();
        auto recip = recipBuf_.Get<float>();
        auto sinkBroadcast = sinkBroadcastBuf_.Get<float>();
        auto maxH2 = maxH2Buf_.Get<float>();
        auto bcastTmp = bcastTmpBuf_.Get<uint8_t>();
        // Hardware reduction (RA pattern, binary tree over the first axis):
        // one API call replaces the 15-op manual max tree.  The scratch lives
        // in this sub-block's maxH2 sum region, dead until the maxH broadcast
        // below is consumed by the Sub.
        const int32_t treeBase = sKBase + vecLen;  // topk*vecLen + vecLen = sKBase+128
        const uint32_t reduceShape[2] = {(uint32_t)topk_, (uint32_t)vecLen};
        AscendC::ReduceMax<float, AscendC::Pattern::Reduce::RA>(
            maxH[rowOff], sK[sKBase],
            maxH2[treeBase + vecLen].ReinterpretCast<uint8_t>(), reduceShape, false);
        AscendC::Max(maxH[rowOff], maxH[rowOff], sinkBroadcast[rowOff], vecLen);

        const uint32_t dstShape[2] = {(uint32_t)topk_, (uint32_t)vecLen};
        const uint32_t srcShape[2] = {1, (uint32_t)vecLen};
        AscendC::Broadcast<float, 2, 0>(maxH2[sKBase], maxH[rowOff],
                                        dstShape, srcShape, bcastTmp);
        AscendC::Sub(sK[sKBase], sK[sKBase], maxH2[sKBase], sKLen);
        AscendC::Exp<float>(sK[sKBase], sK[sKBase], sKLen);
        AscendC::Sub(sumH[rowOff], sinkBroadcast[rowOff], maxH[rowOff], vecLen);
        AscendC::Exp<float>(sumH[rowOff], sumH[rowOff], vecLen);
        // One-call hardware sum reduction (RA pattern) into the dead
        // broadcast scratch; then fold in exp(sink-max) held in sumH.
        AscendC::ReduceSum<float, AscendC::Pattern::Reduce::RA>(
            maxH2[sKBase], sK[sKBase],
            maxH2[treeBase + vecLen].ReinterpretCast<uint8_t>(), reduceShape, false);
        AscendC::Add(sumH[rowOff], sumH[rowOff], maxH2[sKBase], vecLen);
        AscendC::Reciprocal(recip[rowOff], sumH[rowOff], vecLen);
        AscendC::Broadcast<float, 2, 0>(maxH2[sKBase], recip[rowOff],
                                        dstShape, srcShape, bcastTmp);
        AscendC::Mul(sK[sKBase], sK[sKBase], maxH2[sKBase], sKLen);

        // 4. Accumulate into this AIV's rows of [ROWS,N,H] in FP32, cast to
        //    BF16 (the PV GEMM's A is BF16), then transpose to [ROWS,H,N].
        auto aggT = aggTBuf_.Get<float>();
        auto aggTbf16 = aggTbf16Buf_.Get<bfloat16_t>();
        auto aggOut = aggOutQ_.AllocTensor<bfloat16_t>();
        auto revOffset = revOffsetBuf_.Get<int32_t>();
        AscendC::Duplicate<float>(aggT[(int64_t)rowStart * n_ * h_], 0.0f, kN);
        for (int32_t r = 0; r < rows; r++) {
            const int32_t row = rowStart + r;
            #pragma unroll
            for (int32_t k = 0; k < topk_; k++) {
                if (nk[r][k] >= 0 && nk[r][k] < n_) {
                    AscendC::Add(aggT[(int64_t)row * n_ * h_ + (int64_t)nk[r][k] * h_],
                                 aggT[(int64_t)row * n_ * h_ + (int64_t)nk[r][k] * h_],
                                 sK[sKBase + (int64_t)k * vecLen + (int64_t)r * h_], h_);
                }
            }
        }
        idxQ_.FreeTensor(idx);
        AscendC::Cast(aggTbf16[rowNOff], aggT[rowNOff],
                      AscendC::RoundMode::CAST_ROUND, kN);
        for (int32_t r = 0; r < rows; r++) {
            const int32_t row = rowStart + r;
            AscendC::Gather(aggOut[(int64_t)row * h_ * n_], aggTbf16[(int64_t)row * h_ * n_],
                            revOffset.ReinterpretCast<uint32_t>(), 0, (uint32_t)(h_ * n_));
        }
        aggOutQ_.EnQue(aggOut);
    }

    __aicore__ inline void WriteAggOut(int64_t t, int32_t rowStart, int32_t rows)
    {
        const int64_t cOff = t * TILE_M * n_;
        const int64_t rowNOff = (int64_t)rowStart * h_ * n_;

        auto aggOut = aggOutQ_.DeQue<bfloat16_t>();
        AscendC::DataCopyExtParams outParams{1, (uint32_t)(rows * h_ * n_ * sizeof(bfloat16_t)), 0, 0, 0};
        AscendC::DataCopyPad(aggGm_[cOff + rowNOff], aggOut[rowNOff], outParams);
        aggOutQ_.FreeTensor(aggOut);
    }


private:
    template <typename HeaderT>
    __aicore__ inline void LoadTilingFromGM(GM_ADDR tilingGM, HeaderT &dstStack)
    {
        static_assert(alignof(HeaderT) % sizeof(int32_t) == 0,
                      "TilingHeader must be 4-byte aligned");
        constexpr uint32_t HEADER_INTS =
            (sizeof(HeaderT) + sizeof(int32_t) - 1U) / sizeof(int32_t);
        const auto *gmInts = reinterpret_cast<const __gm__ int32_t *>(tilingGM);
        auto *dstInts = reinterpret_cast<int32_t *>(&dstStack);
        for (uint32_t i = 0; i < HEADER_INTS; ++i) {
            dstInts[i] = gmInts[i];
        }
    }

    TPipe *pipe_ = nullptr;
    FusedSparseAttnBasicTiling tiling_;
    int32_t h_ = 0, n_ = 0, d_ = 0, topk_ = 0, mPerBatch_ = 0;
    float scale_ = 0.0f;

    GlobalTensor<bfloat16_t> qGm_;
    GlobalTensor<bfloat16_t> kvGm_;
    GlobalTensor<bfloat16_t> kvTGm_;
    GlobalTensor<float> scoresGm_;
    GlobalTensor<bfloat16_t> aggGm_;
    GlobalTensor<bfloat16_t> outGm_;
    GlobalTensor<int32_t> topkGm_;
    GlobalTensor<float> sinkGm_;

    // AIC L1/L0 queues (max sizes cover both QK and PV tiles)
    TQue<TPosition::A1, 2> inQueueA1_;
    TQue<TPosition::A2, 1> inQueueA2_;
    TQue<TPosition::B1, 2> inQueueB1_;
    TQue<TPosition::B2, 1> inQueueB2_;
    TQue<TPosition::CO1, 1> outQueueCO1_;

    // AIV UB queues
    TQue<TPosition::VECIN, 2> scoresQ_;
    TQue<TPosition::VECIN, 2> idxQ_;
    TQue<TPosition::VECOUT, 2> aggOutQ_;
    TBuf<TPosition::VECCALC> sKBuf_;
    TBuf<TPosition::VECCALC> aggTBuf_;
    TBuf<TPosition::VECCALC> aggTbf16Buf_;
    TBuf<TPosition::VECCALC> maxBuf_;
    TBuf<TPosition::VECCALC> sumBuf_;
    TBuf<TPosition::VECCALC> recipBuf_;
    TBuf<TPosition::VECCALC> maxH2Buf_;
    TBuf<TPosition::VECCALC> bcastTmpBuf_;
    TBuf<TPosition::VECCALC> sinkBroadcastBuf_;
    TBuf<TPosition::VECCALC> sinkBuf_;
    TBuf<TPosition::VECCALC> offsetTableBuf_;
    TBuf<TPosition::VECCALC> baseForwardBuf_;
    TBuf<TPosition::VECCALC> baseReverseBuf_;
    TBuf<TPosition::VECCALC> revOffsetBuf_;
};

extern "C" __global__ __mix__(1, 2) void fused_sparse_attn_basic_kernel(
    GM_ADDR q, GM_ADDR kv, GM_ADDR kvT, GM_ADDR sink, GM_ADDR topk,
    GM_ADDR scores, GM_ADDR agg, GM_ADDR out, GM_ADDR tiling)
{
    TPipe pipe;
    FusedSparseAttnBasicKernel op;
    op.Init(q, kv, kvT, sink, topk, scores, agg, out, tiling, &pipe);
    op.Process();
}
