// ============================================================================
// SparseAttention sink-aware softmax (Vector, row-batched).
//   scores[B, M, H, N] (FP32) + topk[B, M, K] (int32) + sink[H] (FP32)
//       -> agg[B, M, H, N] (BF16)
// ROWS consecutive (b,m) rows are processed together so the softmax math runs
// on full-width (ROWS*H) vectors; gather/accumulate/transpose stay per-row
// (they depend on topk).  Gather is used for both the column-gather and the
// [N,H]->[H,N] transpose (Scatter is unsupported on dav_2201).
// ============================================================================

#include "kernel_operator.h"
#include "sparse_attn_tiling.h"

using namespace AscendC;

static constexpr float NEG_INF = -1e30f;
static constexpr float NEG_INF_HALF = -60000.0f;
static constexpr int32_t ROWS = 4;

class SparseSoftmaxKernel {
public:
    __aicore__ inline SparseSoftmaxKernel(TPipe *pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(GM_ADDR scores, GM_ADDR agg, GM_ADDR topk,
                                GM_ADDR sink, GM_ADDR tilingGM)
    {
        const auto *gmInts = reinterpret_cast<const __gm__ int32_t *>(tilingGM);
        auto *dstInts = reinterpret_cast<int32_t *>(&tiling_);
        constexpr uint32_t INTS =
            (sizeof(SparseSoftmaxTiling) + sizeof(int32_t) - 1U) / sizeof(int32_t);
        for (uint32_t i = 0; i < INTS; ++i) {
            dstInts[i] = gmInts[i];
        }

        totalRows_ = tiling_.totalRows;
        m_ = tiling_.m;
        h_ = tiling_.h;
        n_ = tiling_.n;
        topk_ = tiling_.topk;
        scale_ = tiling_.scale;

        scoresGm_.SetGlobalBuffer((__gm__ half *)scores, (uint64_t)totalRows_ * h_ * n_);
        aggGm_.SetGlobalBuffer((__gm__ bfloat16_t *)agg, (uint64_t)totalRows_ * h_ * n_);
        topkGm_.SetGlobalBuffer((__gm__ int32_t *)topk, (uint64_t)totalRows_ * topk_);
        sinkGm_.SetGlobalBuffer((__gm__ float *)sink, h_);

        const int32_t blockIdx = GetBlockIdx();
        workStart_ = (int64_t)blockIdx * tiling_.workPerBlock;
        workEnd_ = workStart_ + tiling_.workPerBlock;
        if (workEnd_ > totalRows_) {
            workEnd_ = totalRows_;
        }

        pipe_->InitBuffer(scoreQueue_, 2, ROWS * h_ * n_ * sizeof(half));
        pipe_->InitBuffer(idxQueue_, 2, ROWS * topk_ * sizeof(int32_t));
        pipe_->InitBuffer(aggQueue_, 2, ROWS * h_ * n_ * sizeof(bfloat16_t));

        pipe_->InitBuffer(sKBuf_, topk_ * ROWS * h_ * sizeof(float));
        pipe_->InitBuffer(sKHalfBuf_, topk_ * ROWS * h_ * sizeof(half));
        pipe_->InitBuffer(aggTBuf_, ROWS * h_ * n_ * sizeof(float));
        pipe_->InitBuffer(aggTbf16Buf_, ROWS * h_ * n_ * sizeof(bfloat16_t));
        pipe_->InitBuffer(maxBuf_, ROWS * h_ * sizeof(float));
        pipe_->InitBuffer(sumBuf_, ROWS * h_ * sizeof(float));
        pipe_->InitBuffer(sinkBroadcastBuf_, ROWS * h_ * sizeof(float));
        pipe_->InitBuffer(sinkBuf_, h_ * sizeof(float));
        pipe_->InitBuffer(offsetTableBuf_, n_ * h_ * sizeof(int32_t));
        pipe_->InitBuffer(baseForwardBuf_, h_ * sizeof(int32_t));
        pipe_->InitBuffer(baseReverseBuf_, n_ * sizeof(int32_t));
        pipe_->InitBuffer(revOffsetBuf_, ROWS * h_ * n_ * sizeof(int32_t));
    }

    __aicore__ inline void Process()
    {
        if (workStart_ >= workEnd_) {
            return;
        }
        auto sink = sinkBuf_.Get<float>();
        AscendC::DataCopyExtParams sinkParams{1, (uint32_t)(h_ * sizeof(float)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<float> sinkPad{false, 0, 0, 0.0f};
        AscendC::DataCopyPad(sink, sinkGm_, sinkParams, sinkPad);
        AscendC::PipeBarrier<PIPE_ALL>();

        // sinkBroadcast[r*H + h] = sink[h]  (ROWS copies)
        auto sinkBroadcast = sinkBroadcastBuf_.Get<float>();
        for (int32_t r = 0; r < ROWS; r++) {
            AscendC::Adds<float>(sinkBroadcast[(int64_t)r * h_], sink, 0.0f, h_);
        }

        // baseForward[h] = h * N * 4 ; offsetTable[n*H + h] = (h*N + n) * 4
        auto baseForward = baseForwardBuf_.Get<int32_t>();
        for (int32_t hh = 0; hh < h_; hh++) {
            baseForward.SetValue(hh, (int32_t)(hh * n_ * sizeof(half)));
        }
        auto offsetTable = offsetTableBuf_.Get<int32_t>();
        for (int32_t nn = 0; nn < n_; nn++) {
            AscendC::Adds<int32_t>(offsetTable[(int64_t)nn * h_], baseForward,
                                   (int32_t)(nn * sizeof(half)), h_);
        }

        // baseReverse[n] = n * H * 2 ; revOffset[h*N + n] = (n*H + h) * 2  (BF16)
        auto baseReverse = baseReverseBuf_.Get<int32_t>();
        for (int32_t nn = 0; nn < n_; nn++) {
            baseReverse.SetValue(nn, (int32_t)(nn * h_ * sizeof(bfloat16_t)));
        }
        auto revOffset = revOffsetBuf_.Get<int32_t>();
        for (int32_t hh = 0; hh < h_; hh++) {
            AscendC::Adds<int32_t>(revOffset[(int64_t)hh * n_], baseReverse,
                                   (int32_t)(hh * sizeof(bfloat16_t)), n_);
        }
        // revOffset is now the [N,H]->[H,N] transpose offset for one row.
        // Extend to a batched [ROWS, N, H] -> [ROWS, H, N] offset table so all
        // ROWS are transposed in a single full-width Gather.
        for (int32_t r = 1; r < ROWS; r++) {
            AscendC::Adds<int32_t>(revOffset[(int64_t)r * h_ * n_], revOffset,
                                   (int32_t)(r * h_ * n_ * sizeof(bfloat16_t)), h_ * n_);
        }
        AscendC::PipeBarrier<PIPE_ALL>();

        for (int64_t w = workStart_; w < workEnd_; w += ROWS) {
            const int32_t rows = (int32_t)((w + ROWS <= workEnd_) ? ROWS : (workEnd_ - w));
            CopyIn(w, rows);
            Compute(rows);
            CopyOut(w, rows);
        }
    }

private:
    __aicore__ inline void CopyIn(int64_t w, int32_t rows)
    {
        auto score = scoreQueue_.AllocTensor<half>();
        AscendC::DataCopyExtParams inParams{1, (uint32_t)(rows * h_ * n_ * sizeof(half)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<half> inPad{false, 0, 0, 0};
        AscendC::DataCopyPad(score, scoresGm_[w * h_ * n_], inParams, inPad);
        scoreQueue_.EnQue(score);

        auto idx = idxQueue_.AllocTensor<int32_t>();
        AscendC::DataCopyExtParams idxParams{1, (uint32_t)(rows * topk_ * sizeof(int32_t)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<int32_t> idxPad{false, 0, 0, 0};
        AscendC::DataCopyPad(idx, topkGm_[w * topk_], idxParams, idxPad);
        idxQueue_.EnQue(idx);
    }

    __aicore__ inline void Compute(int32_t rows)
    {
        auto score = scoreQueue_.DeQue<half>();         // [rows, H, N]
        auto idx = idxQueue_.DeQue<int32_t>();           // [rows, K]
        auto aggOut = aggQueue_.AllocTensor<bfloat16_t>();  // [rows, H, N]

        auto sK = sKBuf_.Get<float>();                   // [K, ROWS*H]
        auto sKHalf = sKHalfBuf_.Get<half>();             // [K, ROWS*H]
        auto aggT = aggTBuf_.Get<float>();               // [N, H] per row
        auto aggTbf16 = aggTbf16Buf_.Get<bfloat16_t>();
        auto maxH = maxBuf_.Get<float>();                // [ROWS*H]
        auto sumH = sumBuf_.Get<float>();                // [ROWS*H]
        auto sinkBroadcast = sinkBroadcastBuf_.Get<float>();
        auto offsetTable = offsetTableBuf_.Get<int32_t>();
        auto revOffset = revOffsetBuf_.Get<int32_t>();

        // 1. Gather into sKHalf [K, ROWS*H] (half), then cast+scale to sK (fp32).
        for (int32_t r = 0; r < rows; r++) {
            for (int32_t k = 0; k < topk_; k++) {
                const int32_t nk = idx.GetValue(r * topk_ + k);
                if (nk >= 0 && nk < n_) {
                    AscendC::Gather(sKHalf[(int64_t)k * ROWS * h_ + (int64_t)r * h_],
                                    score[(int64_t)r * h_ * n_],
                                    offsetTable[(int64_t)nk * h_].ReinterpretCast<uint32_t>(), 0, (uint32_t)h_);
                } else {
                    AscendC::Duplicate<half>(sKHalf[(int64_t)k * ROWS * h_ + (int64_t)r * h_], NEG_INF_HALF, h_);
                }
            }
        }
        AscendC::Cast(sK, sKHalf, AscendC::RoundMode::CAST_NONE, topk_ * ROWS * h_);
        AscendC::Muls<float>(sK, sK, scale_, topk_ * ROWS * h_);

        // 2. Batched sink-aware softmax over K (full-width rows*H vectors).
        const int32_t rh = rows * h_;
        AscendC::Adds<float>(maxH, sinkBroadcast, 0.0f, rh);
        for (int32_t k = 0; k < topk_; k++) {
            AscendC::Max(maxH, maxH, sK[(int64_t)k * ROWS * h_], rh);
        }
        AscendC::Sub(sumH, sinkBroadcast, maxH, rh);
        AscendC::Exp<float>(sumH, sumH, rh);
        for (int32_t k = 0; k < topk_; k++) {
            AscendC::Sub(sK[(int64_t)k * ROWS * h_], sK[(int64_t)k * ROWS * h_], maxH, rh);
            AscendC::Exp<float>(sK[(int64_t)k * ROWS * h_], sK[(int64_t)k * ROWS * h_], rh);
            AscendC::Add(sumH, sumH, sK[(int64_t)k * ROWS * h_], rh);
        }
        for (int32_t k = 0; k < topk_; k++) {
            AscendC::Div(sK[(int64_t)k * ROWS * h_], sK[(int64_t)k * ROWS * h_], sumH, rh);
        }

        // 3. Batched accumulate into [ROWS, N, H], then a single transposing Gather.
        AscendC::Duplicate<float>(aggT, 0.0f, ROWS * h_ * n_);
        for (int32_t r = 0; r < rows; r++) {
            for (int32_t k = 0; k < topk_; k++) {
                const int32_t nk = idx.GetValue(r * topk_ + k);
                if (nk >= 0 && nk < n_) {
                    AscendC::Add(aggT[(int64_t)r * h_ * n_ + (int64_t)nk * h_],
                                 aggT[(int64_t)r * h_ * n_ + (int64_t)nk * h_],
                                 sK[(int64_t)k * ROWS * h_ + (int64_t)r * h_], h_);
                }
            }
        }
        AscendC::Cast(aggTbf16, aggT, AscendC::RoundMode::CAST_ROUND, rows * h_ * n_);
        AscendC::Gather(aggOut[0], aggTbf16,
                        revOffset.ReinterpretCast<uint32_t>(), 0, (uint32_t)(rows * h_ * n_));

        aggQueue_.EnQue(aggOut);
        scoreQueue_.FreeTensor(score);
        idxQueue_.FreeTensor(idx);
    }

    __aicore__ inline void CopyOut(int64_t w, int32_t rows)
    {
        auto aggOut = aggQueue_.DeQue<bfloat16_t>();
        AscendC::DataCopyExtParams outParams{1, (uint32_t)(rows * h_ * n_ * sizeof(bfloat16_t)), 0, 0, 0};
        AscendC::DataCopyPad(aggGm_[w * h_ * n_], aggOut, outParams);
        aggQueue_.FreeTensor(aggOut);
    }

private:
    TPipe *pipe_ = nullptr;
    SparseSoftmaxTiling tiling_;
    int64_t workStart_ = 0;
    int64_t workEnd_ = 0;
    int32_t totalRows_ = 0;
    int32_t m_ = 0, h_ = 0, n_ = 0, topk_ = 0;
    float scale_ = 0.0f;

    GlobalTensor<half> scoresGm_;
    GlobalTensor<bfloat16_t> aggGm_;
    GlobalTensor<int32_t> topkGm_;
    GlobalTensor<float> sinkGm_;

    TQue<TPosition::VECIN, 2> scoreQueue_, idxQueue_;
    TQue<TPosition::VECOUT, 2> aggQueue_;

    TBuf<TPosition::VECCALC> sKBuf_;
    TBuf<TPosition::VECCALC> sKHalfBuf_;
    TBuf<TPosition::VECCALC> aggTBuf_;
    TBuf<TPosition::VECCALC> aggTbf16Buf_;
    TBuf<TPosition::VECCALC> maxBuf_;
    TBuf<TPosition::VECCALC> sumBuf_;
    TBuf<TPosition::VECCALC> sinkBroadcastBuf_;
    TBuf<TPosition::VECCALC> sinkBuf_;
    TBuf<TPosition::VECCALC> offsetTableBuf_;
    TBuf<TPosition::VECCALC> baseForwardBuf_;
    TBuf<TPosition::VECCALC> baseReverseBuf_;
    TBuf<TPosition::VECCALC> revOffsetBuf_;
};

extern "C" __global__ __vector__ void sparse_softmax_kernel(
    GM_ADDR scores, GM_ADDR agg, GM_ADDR topk, GM_ADDR sink, GM_ADDR tiling)
{
    TPipe pipe;
    SparseSoftmaxKernel op(&pipe);
    op.Init(scores, agg, topk, sink, tiling);
    op.Process();
}
