// ============================================================================
// transpose_kv_kernel (vector-only): kv[B,N,D] -> kvT[B,D,N] (BF16)
// Used by the basic-API megakernel so the QK GEMM can consume B as [D,N].
// One vector block per batch; N=32, D=128, so the whole batch fits in UB.
// ============================================================================
#include "kernel_operator.h"
#include "sparse_attn_tiling.h"

using namespace AscendC;

class TransposeKvKernel {
public:
    __aicore__ inline void Init(GM_ADDR kv, GM_ADDR kvT, GM_ADDR tilingGM)
    {
        const auto *gmInts = reinterpret_cast<const __gm__ int32_t *>(tilingGM);
        auto *dstInts = reinterpret_cast<int32_t *>(&tiling_);
        constexpr uint32_t INTS =
            (sizeof(TransposeKvTiling) + sizeof(int32_t) - 1U) / sizeof(int32_t);
        for (uint32_t i = 0; i < INTS; ++i) {
            dstInts[i] = gmInts[i];
        }
        n_ = tiling_.n;
        d_ = tiling_.d;
        kvGm_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(kv),
                              (uint64_t)tiling_.batchNum * n_ * d_);
        kvTGm_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(kvT),
                               (uint64_t)tiling_.batchNum * d_ * n_);

        pipe_.InitBuffer(inBuf_, n_ * d_ * sizeof(bfloat16_t));
        pipe_.InitBuffer(outBuf_, d_ * n_ * sizeof(bfloat16_t));
        pipe_.InitBuffer(offsetBaseBuf_, n_ * sizeof(int32_t));
        pipe_.InitBuffer(offsetBuf_, n_ * sizeof(int32_t));
    }

    __aicore__ inline void Process()
    {
        const int32_t b = GetBlockIdx();
        if (b >= tiling_.batchNum) {
            return;
        }
        auto in = inBuf_.Get<bfloat16_t>();
        auto out = outBuf_.Get<bfloat16_t>();

        AscendC::DataCopyExtParams inParams{1, (uint32_t)(n_ * d_ * sizeof(bfloat16_t)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<bfloat16_t> inPad{false, 0, 0, 0};
        AscendC::DataCopyPad(in, kvGm_[(int64_t)b * n_ * d_], inParams, inPad);
        AscendC::PipeBarrier<PIPE_ALL>();

        auto offsetBase = offsetBaseBuf_.Get<int32_t>();
        for (int32_t n = 0; n < n_; ++n) {
            offsetBase.SetValue(n, (int32_t)(n * d_ * sizeof(bfloat16_t)));
        }
        auto offsets = offsetBuf_.Get<int32_t>();
        for (int32_t d = 0; d < d_; ++d) {
            AscendC::Adds<int32_t>(offsets, offsetBase, (int32_t)(d * sizeof(bfloat16_t)), n_);
            AscendC::Gather(out[(int64_t)d * n_], in,
                            offsets.ReinterpretCast<uint32_t>(), 0, (uint32_t)n_);
        }
        AscendC::PipeBarrier<PIPE_ALL>();

        AscendC::DataCopyExtParams outParams{1, (uint32_t)(d_ * n_ * sizeof(bfloat16_t)), 0, 0, 0};
        AscendC::DataCopyPad(kvTGm_[(int64_t)b * d_ * n_], out, outParams);
    }

private:
    TPipe pipe_;
    TransposeKvTiling tiling_;
    int32_t n_ = 0, d_ = 0;
    GlobalTensor<bfloat16_t> kvGm_;
    GlobalTensor<bfloat16_t> kvTGm_;
    TBuf<TPosition::VECCALC> inBuf_;
    TBuf<TPosition::VECCALC> outBuf_;
    TBuf<TPosition::VECCALC> offsetBaseBuf_;
    TBuf<TPosition::VECCALC> offsetBuf_;
};

extern "C" __global__ __vector__ void transpose_kv_kernel(
    GM_ADDR kv, GM_ADDR kvT, GM_ADDR tiling)
{
    TransposeKvKernel op;
    op.Init(kv, kvT, tiling);
    op.Process();
}