// ============================================================================
// Fused QK GEMM + sink-aware softmax (mixed AIC+AIV kernel, `__mix__(1,2)`).
//   AIC (cube): KFC server executing the QK MatmulImpl commands sent by AIV.
//   AIV (vector): drives the QK per tile (async IterateAll to a GM scores
//   tile), reads the tile right back (L2-cached round-trip), runs the softmax
//   in UB and writes agg to GM for the PV GEMM.
// Software pipeline: QK(t+1) is issued before softmax(t), so the cube computes
// the next tile while the vector runs the current softmax; the scores/idx/agg
// UB buffers are double-buffered so the async MTE transfers never race the
// vector math.
// One tile = singleCoreM=256 (m,h) rows = 4 m-rows x 64 heads, N=32, K=128.
// ============================================================================

#include "kernel_operator.h"
#include "lib/matmul_intf.h"
#include "sparse_attn_tiling.h"

using namespace AscendC;

static constexpr float NEG_INF_HALF = -60000.0f;
static constexpr int32_t ROWS = 4;
static constexpr int32_t TILE_M = ROWS * 64;  // 256 (m,h) rows per tile

// MDL config with fixpipe write-back (enUnitFlag=true).
constexpr MatmulConfig FUSED_MM_CFG =
    GetMDLConfig(false, false, 2, false, false, false, true);

template <typename HeaderT>
__aicore__ inline void LoadTilingFromGM(GM_ADDR tilingGM, HeaderT &dstStack)
{
    static_assert(alignof(HeaderT) % sizeof(int32_t) == 0,
                  "TilingHeader must be 4-byte aligned");
    constexpr uint32_t HEADER_INTS =
        (sizeof(HeaderT) + sizeof(int32_t) - 1U) / sizeof(int32_t);
    const auto *gmInts = reinterpret_cast<const __gm__ int32_t *>(tilingGM);
    auto *dstInts = reinterpret_cast<int32_t *>(&dstStack);
    for (uint32_t i = 0; i < HEADER_INTS; ++i) {
        dstInts[i] = gmInts[i];
    }
}

class FusedQKSoftmaxKernel {
public:
    using A_TYPE = MatmulType<TPosition::GM, CubeFormat::ND, bfloat16_t, false>;
    using B_TYPE = MatmulType<TPosition::GM, CubeFormat::ND, bfloat16_t, true>;
    using C_TYPE = MatmulType<TPosition::GM, CubeFormat::ND, half>;
    using BIAS_TYPE = MatmulType<TPosition::GM, CubeFormat::ND, float>;

    __aicore__ inline void Init(GM_ADDR q, GM_ADDR kv, GM_ADDR sink, GM_ADDR topk,
                                GM_ADDR scores, GM_ADDR agg, GM_ADDR workspace,
                                GM_ADDR tilingGM, TPipe *pipe)
    {
        pipe_ = pipe;
        LoadTilingFromGM<FusedQKSoftmaxTiling>(tilingGM, tiling_);
        h_ = tiling_.h;
        n_ = tiling_.n;
        topk_ = tiling_.topk;
        scale_ = tiling_.scale;
        mPerBatch_ = tiling_.mPerBatch;
        workspace_ = workspace;

        const int64_t batches = (int64_t)tiling_.totalTiles * ROWS / mPerBatch_;
        qGm_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(q),
                             (uint64_t)tiling_.totalTiles * TILE_M * 128);
        kvGm_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(kv),
                              (uint64_t)batches * n_ * 128);
        scoresGm_.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(scores),
                                   (uint64_t)tiling_.totalTiles * TILE_M * n_);
        aggGm_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(agg),
                               (uint64_t)tiling_.totalTiles * TILE_M * n_);
        topkGm_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(topk),
                                (uint64_t)tiling_.totalTiles * ROWS * topk_);
        sinkGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(sink), h_);

        if ASCEND_IS_AIV {
            pipe->InitBuffer(scoresBufs_[0], TILE_M * n_ * sizeof(half));
            pipe->InitBuffer(scoresBufs_[1], TILE_M * n_ * sizeof(half));
            pipe->InitBuffer(idxBufs_[0], ROWS * topk_ * sizeof(int32_t));
            pipe->InitBuffer(idxBufs_[1], ROWS * topk_ * sizeof(int32_t));
            pipe->InitBuffer(sKHalfBuf_, topk_ * TILE_M * sizeof(half));
            pipe->InitBuffer(sKBuf_, topk_ * TILE_M * sizeof(float));
            pipe->InitBuffer(aggTBuf_, ROWS * n_ * h_ * sizeof(float));
            pipe->InitBuffer(aggTbf16Buf_, ROWS * n_ * h_ * sizeof(bfloat16_t));
            pipe->InitBuffer(aggOutBufs_[0], TILE_M * n_ * sizeof(bfloat16_t));
            pipe->InitBuffer(aggOutBufs_[1], TILE_M * n_ * sizeof(bfloat16_t));
            pipe->InitBuffer(maxBuf_, TILE_M * sizeof(float));
            pipe->InitBuffer(sumBuf_, TILE_M * sizeof(float));
            pipe->InitBuffer(sinkBroadcastBuf_, TILE_M * sizeof(float));
            pipe->InitBuffer(sinkBuf_, h_ * sizeof(float));
            pipe->InitBuffer(offsetTableBuf_, n_ * h_ * sizeof(int32_t));
            pipe->InitBuffer(baseForwardBuf_, h_ * sizeof(int32_t));
            pipe->InitBuffer(baseReverseBuf_, n_ * sizeof(int32_t));
            pipe->InitBuffer(revOffsetBuf_, TILE_M * n_ * sizeof(int32_t));
        }
    }

    __aicore__ inline void Process()
    {
        // Work around a CANN 8.5.2 gap: for 2201 without the super kernel the
        // workspace clear + WORKSPACE_SYNC_ID notify inside ClearWorkspace is
        // dead code, so the KFC client's WaitEvent(15) would hang.  Replicate
        // the intended handshake here (per-core mailbox clear + notify).
        if ASCEND_IS_AIC {
            AscendC::SetAtomicNone();
            AscendC::SetMaskNorm();
            AscendC::SetLoadDataBoundary((uint64_t)0);
            AscendC::SetLoadDataPaddingValue((uint64_t)0);
            AscendC::ClearWorkspaceImpl(workspace_);
            AscendC::NotifyEvent<PIPE_MTE3>(AscendC::WORKSPACE_SYNC_ID);
        } else {
            AscendC::SetVectorMask<uint64_t, AscendC::MaskMode::NORMAL>((uint64_t)-1, (uint64_t)-1);
            AscendC::SetMaskNorm();
        }
        REGIST_MATMUL_OBJ(pipe_, workspace_, qkMm_, &tiling_.cubeTiling);

        // ---- AIV only from here (the AIC is inside the KFC server loop) ----
        const int32_t v = GetBlockIdx();
        const int64_t tileStart = (int64_t)v * tiling_.tilesPerAiv;
        const int64_t tileEnd = tileStart + tiling_.tilesPerAiv;

        PrepareSoftmax();

        // Prologue: issue the first QK tile asynchronously.
        IssueQK(tileStart);

        for (int64_t t = tileStart; t < tileEnd; ++t) {
            // Wait for QK(t) (issued in the previous iteration), read its
            // scores tile into the parity buffer.
            qkMm_.WaitIterateAll();
            auto scoresUB = scoresBufs_[t & 1].Get<half>();
            AscendC::DataCopyExtParams scParams{1, (uint32_t)(TILE_M * n_ * sizeof(half)), 0, 0, 0};
            AscendC::DataCopyPadExtParams<half> scPad{false, 0, 0, 0};
            AscendC::DataCopyPad(scoresUB, scoresGm_[t * TILE_M * n_], scParams, scPad);

            // Issue QK(t+1) so the cube overlaps the softmax below.
            if (t + 1 < tileEnd) {
                IssueQK(t + 1);
            }

            SoftmaxTile(t, scoresUB);
        }

        qkMm_.End();
    }

private:
    __aicore__ inline void IssueQK(int64_t t)
    {
        const int32_t b = (int32_t)((t * ROWS) / mPerBatch_);
        const int64_t aOff = t * TILE_M * 128;
        const int64_t bOff = (int64_t)b * n_ * 128;
        const int64_t cOff = t * TILE_M * n_;
        qkMm_.SetSingleShape(TILE_M, n_, 128);
        qkMm_.SetTensorA(qGm_[aOff], false);
        qkMm_.SetTensorB(kvGm_[bOff], true);
        qkMm_.IterateAll<false>(scoresGm_[cOff], 0, false, true);
    }

    __aicore__ inline void PrepareSoftmax()
    {
        auto sink = sinkBuf_.Get<float>();
        AscendC::DataCopyExtParams sinkParams{1, (uint32_t)(h_ * sizeof(float)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<float> sinkPad{false, 0, 0, 0.0f};
        AscendC::DataCopyPad(sink, sinkGm_, sinkParams, sinkPad);
        AscendC::PipeBarrier<PIPE_ALL>();

        auto sinkBroadcast = sinkBroadcastBuf_.Get<float>();
        for (int32_t r = 0; r < ROWS; r++) {
            AscendC::Adds<float>(sinkBroadcast[(int64_t)r * h_], sink, 0.0f, h_);
        }

        auto baseForward = baseForwardBuf_.Get<int32_t>();
        for (int32_t hh = 0; hh < h_; hh++) {
            baseForward.SetValue(hh, (int32_t)(hh * n_ * sizeof(half)));
        }
        auto offsetTable = offsetTableBuf_.Get<int32_t>();
        for (int32_t nn = 0; nn < n_; nn++) {
            AscendC::Adds<int32_t>(offsetTable[(int64_t)nn * h_], baseForward,
                                   (int32_t)(nn * sizeof(half)), h_);
        }

        auto baseReverse = baseReverseBuf_.Get<int32_t>();
        for (int32_t nn = 0; nn < n_; nn++) {
            baseReverse.SetValue(nn, (int32_t)(nn * h_ * sizeof(bfloat16_t)));
        }
        auto revOffset = revOffsetBuf_.Get<int32_t>();
        for (int32_t hh = 0; hh < h_; hh++) {
            AscendC::Adds<int32_t>(revOffset[(int64_t)hh * n_], baseReverse,
                                   (int32_t)(hh * sizeof(bfloat16_t)), n_);
        }
        for (int32_t r = 1; r < ROWS; r++) {
            AscendC::Adds<int32_t>(revOffset[(int64_t)r * h_ * n_], revOffset,
                                   (int32_t)(r * h_ * n_ * sizeof(bfloat16_t)), h_ * n_);
        }
        AscendC::PipeBarrier<PIPE_ALL>();
    }

    __aicore__ inline void SoftmaxTile(int64_t t, const LocalTensor<half> &scoresUB)
    {
        const int64_t cOff = t * TILE_M * n_;
        const int32_t parity = (int32_t)(t & 1);

        // 1. Load topk indices for the 4 m-rows.
        auto idx = idxBufs_[parity].Get<int32_t>();
        AscendC::DataCopyExtParams idxParams{1, (uint32_t)(ROWS * topk_ * sizeof(int32_t)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<int32_t> idxPad{false, 0, 0, 0};
        AscendC::DataCopyPad(idx, topkGm_[t * ROWS * topk_], idxParams, idxPad);
        AscendC::PipeBarrier<PIPE_ALL>();

        // 2. Gather the K selected columns into sKHalf, cast+scale to sK.
        auto sKHalf = sKHalfBuf_.Get<half>();
        auto sK = sKBuf_.Get<float>();
        auto offsetTable = offsetTableBuf_.Get<int32_t>();
        for (int32_t r = 0; r < ROWS; r++) {
            for (int32_t k = 0; k < topk_; k++) {
                const int32_t nk = idx.GetValue(r * topk_ + k);
                if (nk >= 0 && nk < n_) {
                    AscendC::Gather(sKHalf[(int64_t)k * TILE_M + (int64_t)r * h_],
                                    scoresUB[(int64_t)r * h_ * n_],
                                    offsetTable[(int64_t)nk * h_].ReinterpretCast<uint32_t>(),
                                    0, (uint32_t)h_);
                } else {
                    AscendC::Duplicate<half>(sKHalf[(int64_t)k * TILE_M + (int64_t)r * h_],
                                            NEG_INF_HALF, h_);
                }
            }
        }
        AscendC::Cast(sK, sKHalf, AscendC::RoundMode::CAST_NONE, topk_ * TILE_M);
        AscendC::Muls<float>(sK, sK, scale_, topk_ * TILE_M);

        // 3. Batched sink-aware softmax over K (full-width TILE_M vectors).
        auto maxH = maxBuf_.Get<float>();
        auto sumH = sumBuf_.Get<float>();
        auto sinkBroadcast = sinkBroadcastBuf_.Get<float>();
        AscendC::Adds<float>(maxH, sinkBroadcast, 0.0f, TILE_M);
        for (int32_t k = 0; k < topk_; k++) {
            AscendC::Max(maxH, maxH, sK[(int64_t)k * TILE_M], TILE_M);
        }
        AscendC::Sub(sumH, sinkBroadcast, maxH, TILE_M);
        AscendC::Exp<float>(sumH, sumH, TILE_M);
        for (int32_t k = 0; k < topk_; k++) {
            AscendC::Sub(sK[(int64_t)k * TILE_M], sK[(int64_t)k * TILE_M], maxH, TILE_M);
            AscendC::Exp<float>(sK[(int64_t)k * TILE_M], sK[(int64_t)k * TILE_M], TILE_M);
            AscendC::Add(sumH, sumH, sK[(int64_t)k * TILE_M], TILE_M);
        }
        for (int32_t k = 0; k < topk_; k++) {
            AscendC::Div(sK[(int64_t)k * TILE_M], sK[(int64_t)k * TILE_M], sumH, TILE_M);
        }

        // 4. Batched accumulate into [ROWS, N, H], transpose to [ROWS, H, N].
        auto aggT = aggTBuf_.Get<float>();
        auto aggTbf16 = aggTbf16Buf_.Get<bfloat16_t>();
        auto aggOut = aggOutBufs_[parity].Get<bfloat16_t>();
        auto revOffset = revOffsetBuf_.Get<int32_t>();
        AscendC::Duplicate<float>(aggT, 0.0f, ROWS * n_ * h_);
        for (int32_t r = 0; r < ROWS; r++) {
            for (int32_t k = 0; k < topk_; k++) {
                const int32_t nk = idx.GetValue(r * topk_ + k);
                if (nk >= 0 && nk < n_) {
                    AscendC::Add(aggT[(int64_t)r * n_ * h_ + (int64_t)nk * h_],
                                 aggT[(int64_t)r * n_ * h_ + (int64_t)nk * h_],
                                 sK[(int64_t)k * TILE_M + (int64_t)r * h_], h_);
                }
            }
        }
        AscendC::Cast(aggTbf16, aggT, AscendC::RoundMode::CAST_ROUND, ROWS * n_ * h_);
        AscendC::Gather(aggOut[0], aggTbf16,
                        revOffset.ReinterpretCast<uint32_t>(), 0, (uint32_t)(TILE_M * n_));
        AscendC::PipeBarrier<PIPE_ALL>();

        // 5. Write agg to GM (consumed by the PV GEMM).
        AscendC::DataCopyExtParams outParams{1, (uint32_t)(TILE_M * n_ * sizeof(bfloat16_t)), 0, 0, 0};
        AscendC::DataCopyPad(aggGm_[cOff], aggOut, outParams);
    }

private:
    TPipe *pipe_ = nullptr;
    FusedQKSoftmaxTiling tiling_;
    int32_t h_ = 0, n_ = 0, topk_ = 0, mPerBatch_ = 0;
    float scale_ = 0.0f;
    GM_ADDR workspace_ = nullptr;

    GlobalTensor<bfloat16_t> qGm_;
    GlobalTensor<half> scoresGm_;
    GlobalTensor<bfloat16_t> kvGm_;
    GlobalTensor<bfloat16_t> aggGm_;
    GlobalTensor<int32_t> topkGm_;
    GlobalTensor<float> sinkGm_;

    Matmul<A_TYPE, B_TYPE, C_TYPE, BIAS_TYPE, FUSED_MM_CFG> qkMm_;

    TBuf<TPosition::VECCALC> scoresBufs_[2];
    TBuf<TPosition::VECCALC> idxBufs_[2];
    TBuf<TPosition::VECCALC> sKHalfBuf_;
    TBuf<TPosition::VECCALC> sKBuf_;
    TBuf<TPosition::VECCALC> aggTBuf_;
    TBuf<TPosition::VECCALC> aggTbf16Buf_;
    TBuf<TPosition::VECCALC> aggOutBufs_[2];
    TBuf<TPosition::VECCALC> maxBuf_;
    TBuf<TPosition::VECCALC> sumBuf_;
    TBuf<TPosition::VECCALC> sinkBroadcastBuf_;
    TBuf<TPosition::VECCALC> sinkBuf_;
    TBuf<TPosition::VECCALC> offsetTableBuf_;
    TBuf<TPosition::VECCALC> baseForwardBuf_;
    TBuf<TPosition::VECCALC> baseReverseBuf_;
    TBuf<TPosition::VECCALC> revOffsetBuf_;
};

extern "C" __global__ __mix__(1, 2) void fused_qk_softmax_kernel(
    GM_ADDR q, GM_ADDR kv, GM_ADDR sink, GM_ADDR topk, GM_ADDR scores,
    GM_ADDR agg, GM_ADDR workspace, GM_ADDR tiling)
{
    TPipe pipe;
    FusedQKSoftmaxKernel op;
    op.Init(q, kv, sink, topk, scores, agg, workspace, tiling, &pipe);
    op.Process();
}
